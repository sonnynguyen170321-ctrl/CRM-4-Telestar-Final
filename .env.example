# ─── Database Connection ──────────────────────────────────────────────────────
# Standard PostgreSQL — works with any Postgres (local, AWS RDS, Supabase, Neon).
# DATABASE_URL is the app's pooled/runtime connection; DIRECT_URL is a direct (TCP)
# connection used by Prisma migrations AND by the always-on worker for multi-step
# transactions. For a single Postgres instance the two can be identical.
#
# Local development:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/telestar_crm"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/telestar_crm"

# Throwaway database the migration drift gate replays into. `npm run db:drift` recreates its
# contents on every run, so it holds nothing you care about — but it must exist:
#   CREATE DATABASE telestar_shadow;
# Named here rather than hardcoded in docs, because the two machines had drifted onto different
# names and the documented drift command therefore failed on one of them.
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/telestar_shadow"
#
# Production (e.g. AWS RDS — require TLS):
# DATABASE_URL="postgresql://[user]:[password]@[rds-endpoint]:5432/telestar_crm?sslmode=require"
# DIRECT_URL="postgresql://[user]:[password]@[rds-endpoint]:5432/telestar_crm?sslmode=require"
# If DATABASE_URL points at a pooler (pgBouncer / RDS Proxy), keep DIRECT_URL on the
# non-pooled endpoint — the worker's interactive transactions require a real TCP session.

# ─── NextAuth Settings ────────────────────────────────────────────────────────
# Generate a secret via: openssl rand -base64 32   (use a FRESH value in production)
AUTH_SECRET="your_nextauth_auth_secret_here"
# Set to the public app URL in production, e.g. https://crm.yourdomain.com
NEXTAUTH_URL="http://localhost:3000"

# ─── BullMQ / Redis (workers + optional cache) ────────────────────────────────
# REQUIRED for the always-on worker host (npm run worker:start) AND for the web app,
# which enqueues jobs onto the SAME Redis. Both must point at one shared instance, or
# jobs sit at status='queued' forever (producer and consumer on different brokers).
# Local dev: redis://localhost:6379
# Production: managed Redis (AWS ElastiCache / Upstash / Redis Cloud).
#   → use the rediss:// scheme if the endpoint enforces in-transit TLS (ElastiCache).
REDIS_URL="redis://localhost:6379"

# ─── Google Gmail OAuth ───────────────────────────────────────────────────────
# Get these from Google Developer Console (https://console.cloud.google.com)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/email/oauth/google/callback"

# ─── Microsoft Outlook OAuth ──────────────────────────────────────────────────
# Get these from Azure Active Directory Portal (https://portal.azure.com)
MICROSOFT_CLIENT_ID="your_microsoft_client_id_here"
MICROSOFT_CLIENT_SECRET="your_microsoft_client_secret_here"
MICROSOFT_REDIRECT_URI="http://localhost:3000/api/email/oauth/microsoft/callback"

# ─── Credential Encryption ───────────────────────────────────────────────────
# AES-256 key for encrypting IMAP/SMTP passwords + OAuth tokens at rest.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="your_64_char_hex_key_here"

# ─── AI SDR Assistant ─────────────────────────────────────────────────────────
# The in-app AI assistant uses Groq as the primary provider and Gemini as the
# rate-limit fallback (lib/ai/provider.ts). Set at least GROQ_API_KEY, or the
# assistant returns a friendly "unavailable" message.
# Groq: https://console.groq.com/keys   ·   Gemini: https://aistudio.google.com/apikey
GROQ_API_KEY="your_groq_api_key_here"
GEMINI_API_KEY="your_gemini_api_key_here"

# ─── Sequence Automation Crons ────────────────────────────────────────────────
# Bearer token the host scheduler (PM2 / OS cron / ECS scheduled task) sends to the
# /api/cron/* routes. NOTE: on AWS there is no Vercel Cron — a scheduler must curl
# these endpoints (e.g. every 5 min) or inbound-mail sync + the smart-send scanner
# never run. Generate via: openssl rand -hex 32
#   curl -H "Authorization: Bearer $CRON_SECRET" https://your-host/api/cron/sequence-engine
CRON_SECRET="your_cron_secret_here"
# Global kill switch for unattended sequence email sending ("false" disables live sends).
SEQUENCE_AUTOSEND_ENABLED="false"

# Hard dry-run for outbound email worker.
# When "true", the worker marks messages as dry-run instead of calling the email provider.
EMAIL_SEND_DRY_RUN="true"

# Deliverability auto-pause. When "true", workers/email.ts refuses to send from an inbox
# whose healthLevel is "critical". Default off: a manager-set pause always hard-blocks,
# but an automatic score should raise alerts rather than silently halt a client campaign.
# Turn this on once the scoring thresholds are trusted in production.
#   Health cron (hourly): curl -H "Authorization: Bearer $CRON_SECRET" https://your-host/api/cron/email-health
EMAIL_HEALTH_AUTOPAUSE="false"

# ─── Audit log retention ──────────────────────────────────────────────────────
# lib/audit.ts writes an AuditLog row for every create/update/delete on every model,
# so the table grows without bound. The maintenance cron's "audit-prune" repair trims
# it in bounded batches.
#   Maintenance cron (daily): curl -H "Authorization: Bearer $CRON_SECRET" https://your-host/api/cron/maintenance
# Automatic rows written by the Prisma extension — the bulk of the table.
AUDIT_RETENTION_DAYS="90"
# Actor-stamped admin.* rows written by logAdminAudit — the compliance-relevant trail,
# kept longer. Clamped at runtime to at least AUDIT_RETENTION_DAYS.
ADMIN_AUDIT_RETENTION_DAYS="365"
