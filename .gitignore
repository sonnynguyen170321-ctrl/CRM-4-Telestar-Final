sidebar-1024px.png

# --- repo hygiene (source-control cleanup) ---

# QA / audit screenshots at repo root (Playwright captures — regenerate, don't version).
# Root-anchored, so public/**/*.png stays tracked.
/*.png

# Local archives and scratch space
*.zip
/scratch/
/_proper_repo/

# QA lane evidence: screenshots, console/network logs, data dumps. Regenerate by
# re-running the lanes. Kept out of git because it is bulky and reproducible — the
# written FINDINGS.md reports are the durable artefact and live alongside it.
/qa-runs/
/test-results/

# e2e/qa/ (the six-lane harness) is deliberately NOT ignored any more. It was, and the
# specs silently drifted from the runs that produced the evidence: lane F's F3 assertion
# was deleted rather than fixed after it caught a real defect, so the suite would have
# passed whether or not the bug came back. A test that can vanish unnoticed is not a gate.

# Agent tooling: machine-local ECC install.
# Keep only .claude/rules/ (CLAUDE.md loads it) and .claude/settings.json.
/.claude/*
!/.claude/rules/
!/.claude/settings.json
/.agents/
/.codex/
/.impeccable/
/.github/skills/
/.github/hooks/

# Deployment record written on the VM by scripts/deploy.sh. The VM is a git checkout, so a
# tracked file here would conflict on every `git pull`.
deployments.ndjson
.env.production.bak
.env.docker.bak

# CI diagnostic output (tee'd into job summaries, never committed)
gitleaks-report.json
lint.log
tsc.log
vitest.log
seed.log
build.log
playwright.log
server.log
gitleaks.log

# Playwright deep audit — generated, never committed
playwright/.auth/
e2e/.fixture.json
