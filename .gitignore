# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but keep the documented example (no real secrets) in the repo
!.env.example
!.env.docker.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local settings (machine-specific, contains session paths)
.claude/settings.local.json
.claude/worktrees/

.vercel

# ECC Installer Repository
Claude-Everything-setup/

# Playwright MCP browser audit artifacts (screenshots, snapshots)
.playwright-mcp/
final-dashboard.png
final-leads.png
final-team.png
final-templates.png
sidebar-1024px.png

# --- repo hygiene (source-control cleanup) ---

# QA / audit screenshots at repo root (Playwright captures — regenerate, don't version).
# Root-anchored, so public/**/*.png stays tracked.
/*.png

# Local archives and scratch space
*.zip
/scratch/
/_proper_repo/

# Parallel QA lane run: throwaway specs + their evidence (screenshots, console/network logs).
# Regenerate by re-running the lanes; never commit.
/qa-runs/
/e2e/qa/
/test-results/

# Agent tooling: machine-local ECC install.
# Keep only .claude/rules/ (CLAUDE.md loads it) and .claude/settings.json.
/.claude/*
!/.claude/rules/
!/.claude/settings.json
/.agents/
/.codex/
/.impeccable/
/.github/skills/
/.github/hooks/
