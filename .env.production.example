# Production env template for the GCE + Docker Compose + Caddy topology.
#
# Copy to `.env.production` ON THE VM and fill in every <placeholder>. Never commit the
# filled file — `.gitignore` blocks `.env*`, and only this `.example` is whitelisted.
#
# Validate before launching:
#   docker compose ... run --rm -v $PWD/.env.production:/app/.env.production:ro web npm run prod:check-env
#
# `scripts/prod-check-env.ts` requires ALL twelve keys below and rejects any value matching
# /<[^>]+>|replace|change-me|todo|localhost|example\.com/i — so this template intentionally
# FAILS validation until you replace the placeholders.

# --- compose plumbing -------------------------------------------------------
# Target architecture: "gcp" (Cloud SQL + Compose Caddy/Redis) or "self-hosted" (Compose Postgres/Redis).
DEPLOY_TARGET=gcp
# APP_ENV_FILE must name this file: docker-compose.yml reads `env_file: ${APP_ENV_FILE}`.
APP_ENV_FILE=.env.production

# The exact image to run. No default and no `:latest` — a mutable tag means two `up -d`
# runs a week apart can start different code with nothing recording the change. Compose
# refuses to start if this is unset.
#
# Prefer a digest; a full-git-sha tag is also accepted. `scripts/deploy.sh` resolves the
# digest, writes it here, and keeps the one it replaced in PREVIOUS_CRM_IMAGE.
CRM_IMAGE=ghcr.io/sonnynguyen170321-ctrl/crm-4-telestar-final@sha256:<digest>
# The last image known to have served traffic. `scripts/rollback.sh` deploys this.
PREVIOUS_CRM_IMAGE=

# --- host + TLS -------------------------------------------------------------
# Domain mode (recommended): CADDY_SITE_ADDRESS is the bare hostname, which is what makes
# Caddy request a Let's Encrypt certificate. NEXTAUTH_URL must then be https:// and its
# hostname must equal CRM_DOMAIN exactly.
#
# IP mode (no domain yet): set CADDY_SITE_ADDRESS=:80 and NEXTAUTH_URL=http://<STATIC_IP>.
# prod-check-env enforces the pairing in both directions — you cannot mix them.
CRM_DOMAIN=<crm.yourcompany.com>
CADDY_SITE_ADDRESS=<crm.yourcompany.com>
NEXTAUTH_URL=https://<crm.yourcompany.com>

# --- database ---------------------------------------------------------------
# Cloud SQL, not the compose-local postgres: prod-check-env rejects a DB host of
# localhost / 127.0.0.1 / ::1 / postgres. `docker-compose.gcp.yml` disables the local
# postgres service via a profile for exactly this reason.
#
# All three URLs are required and MUST share the same hostname. BACKUP_DATABASE_URL points
# at the same instance unless you have a read replica.
#
# Keep the DB password alphanumeric — a raw / + or = corrupts the URL unless percent-encoded.
DATABASE_URL="postgresql://crm:<DB_PASSWORD>@<CLOUD_SQL_IP>:5432/telestar_crm?schema=public&sslmode=require"
DIRECT_URL="postgresql://crm:<DB_PASSWORD>@<CLOUD_SQL_IP>:5432/telestar_crm?schema=public&sslmode=require"
BACKUP_DATABASE_URL="postgresql://crm:<DB_PASSWORD>@<CLOUD_SQL_IP>:5432/telestar_crm?schema=public&sslmode=require"

# --- redis ------------------------------------------------------------------
# Compose-local Redis on the same VM. `redis` is the compose service name, resolved on the
# crm_internal bridge network. Swap for a rediss:// Memorystore URL only if you provision one.
REDIS_URL="redis://redis:6379"
# Managed Redis: use rediss:// (TLS). Credentials go in the URL; ioredis parses them.
# Required eviction policy: noeviction — see docs/REDIS_MIGRATION.md.
# REDIS_URL="rediss://default:<password>@<host>:6380"

# --- secrets ----------------------------------------------------------------
# Generate on the VM (NOT in Windows PowerShell — CRLF appends \r and makes ENCRYPTION_KEY
# 65 chars, which fails the /^[0-9a-f]{64}$/i check in lib/env.ts and crashloops the app):
#   AUTH_SECRET:    openssl rand -base64 32     (min 32 chars)
#   ENCRYPTION_KEY: openssl rand -hex 32        (exactly 64 hex chars)
#   CRON_SECRET:    openssl rand -hex 32        (min 32 chars)
AUTH_SECRET=<openssl rand -base64 32>
ENCRYPTION_KEY=<openssl rand -hex 32>
CRON_SECRET=<openssl rand -hex 32>

# --- outbound email safety --------------------------------------------------
# These two values are enforced, not advisory: prod-check-env FAILS on anything else.
# Both flags are fail-open in application code — EMAIL_SEND_DRY_RUN engages only on the
# literal "true", and SEQUENCE_AUTOSEND_ENABLED disables only on the literal "false" — so
# an unset or misspelled value means real mail goes out. Leave these exactly as written
# until a deliberate go-live decision is made.
EMAIL_SEND_DRY_RUN=true
SEQUENCE_AUTOSEND_ENABLED=false
