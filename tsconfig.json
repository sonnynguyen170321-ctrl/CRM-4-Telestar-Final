{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@telestar/*": ["./packages/*/src"]
    },
    "types": ["node", "react", "react-dom"]
  },
  // `apps/*` is excluded on purpose: each app owns its own tsconfig and its own `@/*` root. Type
  // checking apps/leadgen from here would resolve its `@/lib/...` imports against the CRM root and
  // report hundreds of phantom errors. Apps are checked by their own `tsc`, packages are not — they
  // are first-party source to whichever app compiles them.
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "Claude-Everything-setup",
    ".claude",
    "_proper_repo",
    "scratch",
    "apps"
  ]
}
