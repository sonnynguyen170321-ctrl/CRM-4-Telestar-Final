// â”€â”€ V2 AI governance (settings / providers / models / rate limits / usage / logs) â”€â”€
// AI is ADVISORY + OPTIONAL: it never overwrites the deterministic qualification and
// is never forced per company/scoring. These models govern when/how the LLM engine
// may fire. Soft FKs (organizationId String) per the V2 child-table convention.

enum V2AiMode {
  OFF
  UNCERTAIN_ONLY
  ALL
}

enum V2AiProviderKind {
  GEMINI
  OPENAI
  ANTHROPIC
}

enum V2AiRunStatus {
  OK
  TIMEOUT
  ERROR
  RATE_LIMITED
  SKIPPED
}

// One row per org. Master switch + mode + default model + daily request budget.
model V2AiSettings {
  id                String           @id @default(cuid())
  organizationId    String           @unique
  enabled           Boolean          @default(false)
  mode              V2AiMode         @default(UNCERTAIN_ONLY)
  provider          V2AiProviderKind @default(GEMINI)
  defaultModelId    String?
  maxRowsPerUpload  Int              @default(100)
  dailyCreditBudget Int              @default(2000) // credit = 1 AI request
  resultHandling    String           @default("APPEND_ONLY")
  environment       String           @default("production")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model V2AiProviderConfig {
  id                  String           @id @default(cuid())
  organizationId      String
  provider            V2AiProviderKind
  enabled             Boolean          @default(false)
  lastHealthAt        DateTime?
  lastHealthOk        Boolean?
  lastHealthLatencyMs Int?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([organizationId, provider])
}

model V2AiModel {
  id                 String           @id @default(cuid())
  organizationId     String
  provider           V2AiProviderKind
  modelId            String // e.g. "gemini-flash-latest", "gpt-4o-mini"
  label              String
  maxOutputTokens    Int              @default(1024)
  defaultTemperature Decimal          @default(0.20) @db.Decimal(3, 2)
  active             Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([organizationId, provider, modelId])
  @@index([organizationId, active])
}

model V2AiRateLimit {
  id                 String           @id @default(cuid())
  organizationId     String
  provider           V2AiProviderKind
