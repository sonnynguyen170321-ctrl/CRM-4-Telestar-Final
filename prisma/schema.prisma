  leadName            String?
  companyName         String?
  priority            String          @default("medium")
  status              String          @default("open")
  reasonsJson         Json?
  sourceNote          String?
  managerNote         String?
  nextAction          String?
  reviewedBy          String?
  reviewedAt          DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([status])
  @@index([priority])
  @@index([sdrName])
  @@index([activityUploadId])
  @@index([contactRecordId])
  @@index([companyRecordId])
}

model FeedbackExample {
  id                   String  @id @default(cuid())
  companyRecordId      String?
  companyScoreResultId String?
  feedbackImportJobId  String?

  companyName String
  website     String?

  predictedCompanyScore  Int?
  predictedCompanyType   CompanyType?
  predictedQualification Qualification?
  predictedReason        String?

  finalCompanyScore  Int
  finalCompanyType   CompanyType
  finalQualification Qualification
  finalNote          String?

  approvedForLearning       Boolean      @default(false)
  useForPromptRefinement    Boolean      @default(false)
  useForRuleTuning          Boolean      @default(false)
  useForModelTraining       Boolean      @default(false)
  useForEvaluationBenchmark Boolean      @default(false)
  datasetSplit              DatasetSplit @default(UNSPECIFIED)

  promptVersion String?
  ruleVersion   String?
  modelVersion  String?

  source         FeedbackSource @default(LOCAL_UI)
  rawExampleJson Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  companyRecord      CompanyRecord?      @relation(fields: [companyRecordId], references: [id])
  companyScoreResult CompanyScoreResult? @relation(fields: [companyScoreResultId], references: [id])
  feedbackImportJob  FeedbackImportJob?  @relation(fields: [feedbackImportJobId], references: [id])

  @@index([companyName])
  @@index([website])
  @@index([finalQualification])
  @@index([datasetSplit])
  @@index([approvedForLearning])
}

model ExportJob {
  id          String   @id @default(cuid())
  uploadJobId String?
  fileName    String
  exportType  String
  rowCount    Int      @default(0)
  createdAt   DateTime @default(now())

  uploadJob UploadJob? @relation(fields: [uploadJobId], references: [id])

  @@index([uploadJobId])
}

model AiRuntimeSetting {
  id               String   @id
  enabled          Boolean?
  scoringMode      String?
  maxRowsPerUpload Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Phase R (R1) â€” BullMQ runtime mirror. BullMQ executes work; these Postgres tables are
// the truth/audit/status surface the UI reads (BullMQ payloads stay pointer-only). Soft
// FKs (String ids, no @relation) per V2 convention. status is text:
// QUEUED|RUNNING|SUCCEEDED|FAILED|PARTIAL|CANCELLED. Tenant-scoped (Invariant 5).
model V2RuntimeRun {
  id             String  @id @default(cuid())
  organizationId String
  projectId      String?
  icpVersionId   String?
  runType        String // SCORING | ENRICHMENT | READMODEL | EXPORT | ...
  status         String  @default("QUEUED")
  priority       Int     @default(0)

  totalUnits     Int @default(0)
  processedUnits Int @default(0)
  succeededUnits Int @default(0)
  failedUnits    Int @default(0)
  skippedUnits   Int @default(0)

  configJson       Json?
  errorSummaryJson Json?
  createdByUserId  String?
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([organizationId, runType, status])
  @@index([organizationId, projectId, status])
  @@index([organizationId, createdAt])
}

model V2RuntimeStage {
  id             String @id @default(cuid())
  organizationId String
  runId          String
  stageType      String // e.g. scoring.plan | scoring.chunk | scoring.reduce
  status         String @default("QUEUED")

  totalUnits     Int @default(0)
  processedUnits Int @default(0)
  failedUnits    Int @default(0)

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([organizationId, runId, stageType])
  @@index([organizationId, status])
}

model V2RuntimeChunk {
  id             String  @id @default(cuid())
  organizationId String
  runId          String
  stageId        String
  chunkIndex     Int
  chunkType      String
  status         String  @default("QUEUED")
  bullJobId      String?
  dedupeKey      String

  cursorStart    String?
  cursorEnd      String?
  unitCount      Int     @default(0)
  processedUnits Int     @default(0)

  attemptCount Int     @default(0)
  maxAttempts  Int     @default(3)
  workerId     String?
  errorCode    String?
  errorJson    Json?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  startedAt  DateTime?
  finishedAt DateTime?

  @@unique([organizationId, dedupeKey])
  @@unique([runId, chunkIndex])
  @@index([organizationId, runId, status])
  @@index([organizationId, stageId, status])
}

// Separate from the outreach V2WorkerHeartbeat (which W9 sender-readiness reads) â€” this
// one tracks BullMQ runtime workers without touching that surface.
model V2RuntimeWorkerHeartbeat {
  id             String   @id @default(cuid())
  workerId       String   @unique
  organizationId String?
  queueName      String
  status         String   @default("ONLINE")
  host           String?
  pid            Int?
  currentJobId   String?
  lastBeatAt     DateTime
  metadataJson   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([queueName, status])
  @@index([lastBeatAt])
}

// P4 (budget rail): per-org per-provider daily call counters. The enrichment path
// records search usage here and skips provider calls once the daily cap is reached,
// degrading to website-only evidence (never a hard failure). Tenant-scoped (Inv 5).
model V2ProviderUsageDaily {
  id             String   @id @default(cuid())
  organizationId String
  provider       String
  usageDate      DateTime @db.Date
  requests       Int      @default(0)
  errors         Int      @default(0)
  rateLimited    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, provider, usageDate])
  @@index([organizationId, usageDate])
}

// P4 split: checkpoint between the research.fetch and research.extract BullMQ stages.
// fetch writes the raw crawled+searched material here (pointer-only payloads in Redis);
// extract reads it, compiles+persists the profile, then deletes the row. Tenant-scoped.
model V2CompanyResearchStaging {
  id              String   @id @default(cuid())
  organizationId  String
  companyId       String
  researchVersion Int
  materialJson    Json
  createdAt       DateTime @default(now())

  @@unique([organizationId, companyId, researchVersion])
  @@index([organizationId, createdAt])
}

enum V2ResearchRunKind {
  COMPANY
  CONTACT
}

enum V2ResearchRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum V2ResearchCandidateStatus {
  DISCOVERED
  DUPLICATE
  PROMOTED
  DISMISSED
}

// ICP-driven prospect discovery: a run derives search queries from a published ICP's
// rules, executes them through the env-gated search providers, and harvests candidates
// with cited sources. Candidates are NOT companies/contacts until promoted (Inv 7).
model V2ResearchRun {
  id              String              @id @default(cuid())
  organizationId  String
  icpVersionId    String
  projectId       String
  kind            V2ResearchRunKind
  status          V2ResearchRunStatus @default(QUEUED)
  queriesJson     Json
  paramsJson      Json?
  queryCursor     Int                 @default(0)
  discoveredCount Int                 @default(0)
  duplicateCount  Int                 @default(0)
  errorMessage    String?
  createdByUserId String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  organization         V2Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  v2ResearchCandidates V2ResearchCandidate[]
  evidence             V2ResearchEvidence[]
  providerAttempts     V2ResearchProviderAttempt[]

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([deletedAt])
}

model V2ResearchCandidate {
  id                String                    @id @default(cuid())
  organizationId    String
  runId             String
  kind              V2ResearchRunKind
  name              String
  domain            String?
  linkedinUrl       String?
  title             String?
  companyName       String?
  sourceJson        Json // { query, url, snippet, provider } â€” the evidence
  matchHintsJson    Json // which ICP tokens/terms the result matched
  dedupeFingerprint String
  status            V2ResearchCandidateStatus @default(DISCOVERED)
  fitScore          Int? // 0-100 ICP fit; heuristic always, AI when opted in
  fitReason         String?
  fitSource         String? // "ai" | "heuristic"
  location          String?
  translatedName    String?
  translatedSnippet String?
  emailGuess        String?
  emailStatus       String? // "GUESSED" | "VERIFIED" | "UNKNOWN"
  phone             String?
  insightJson       Json? // business insight (summary/whatTheySell/industry/size/hq/signals/citations)
  enrichedAt        DateTime?
  promotedCompanyId String?
  promotedContactId String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  deletedAt         DateTime?

  organization V2Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  run          V2ResearchRun  @relation(fields: [runId], references: [id], onDelete: Restrict)
  evidence     V2ResearchEvidence[]
  observations V2ResearchFieldObservation[]
  attempts     V2ResearchProviderAttempt[]

  @@unique([organizationId, runId, dedupeFingerprint])
  @@index([organizationId, dedupeFingerprint])
  @@index([organizationId, runId, status])
  @@index([organizationId, runId, fitScore])
  @@index([deletedAt])
}

// Candidate/run-level provenance captured before promotion. This is research evidence only;
// CRM intelligence remains in V2CompanyResearchSnapshot/V2CompanyIntelligenceProfile.
model V2ResearchEvidence {
  id             String   @id @default(cuid())
  organizationId String
  runId          String?
  candidateId    String?
  idempotencyKey String
  sourceKind     String
  provider       String?
  sourceUrl      String?
  sourceTitle    String?
  sourceSnippet  String?
  query          String?
  confidence     Int?
  evidenceJson   Json?
  observedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  organization V2Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  run          V2ResearchRun?       @relation(fields: [runId], references: [id], onDelete: SetNull)
  candidate    V2ResearchCandidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  observations V2ResearchFieldObservation[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, runId, createdAt])
  @@index([organizationId, candidateId, createdAt])
  @@index([organizationId, sourceKind])
}

model V2ResearchFieldObservation {
  id             String   @id @default(cuid())
  organizationId String
  candidateId    String
  evidenceId     String?
  fieldName      String
  valueText      String?
  valueJson      Json?
  confidence     Int?
  sourceKind     String
  createdAt      DateTime @default(now())

  organization V2Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  candidate    V2ResearchCandidate  @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  evidence     V2ResearchEvidence?  @relation(fields: [evidenceId], references: [id], onDelete: SetNull)

  @@index([organizationId, candidateId, fieldName])
  @@index([organizationId, evidenceId])
}

model V2ResearchProviderAttempt {
  id             String   @id @default(cuid())
  organizationId String
  runId          String?
  candidateId    String?
  stage          String
  provider       String
  status         String
  requestJson    Json?
  responseJson   Json?
  errorMessage   String?
  startedAt      DateTime @default(now())
  finishedAt     DateTime?
  createdAt      DateTime @default(now())

  organization V2Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  run          V2ResearchRun?       @relation(fields: [runId], references: [id], onDelete: SetNull)
  candidate    V2ResearchCandidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  @@index([organizationId, runId, stage, createdAt])
  @@index([organizationId, candidateId, stage, createdAt])
  @@index([organizationId, provider, status, createdAt])
}

model V2ResearchEmailPattern {
  id             String   @id @default(cuid())
  organizationId String
  domain         String
  pattern        String
  confidence     Int      @default(0)
  sampleCount    Int      @default(0)
  sourceJson     Json?
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization V2Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, domain, pattern])
  @@index([organizationId, domain, confidence])
}
// Durable per-org prospect ledger. Every discovered candidate upserts its prospect here so
// re-running any ICP/search shows first/last-seen dates and cross-run recency dedupe (Inv 6).
// This is NOT a CRM row (Inv 7) â€” promotion still creates V2Company/V2Contact separately.
model V2ResearchProspect {
  id                String            @id @default(cuid())
  organizationId    String
  kind              V2ResearchRunKind
  dedupeFingerprint String
  domain            String?
  linkedinUrl       String?
  displayName       String
  firstSeenAt       DateTime          @default(now())
  lastSeenAt        DateTime          @default(now())
  timesSeen         Int               @default(1)
  lastRunId         String?
  promotedCompanyId String?
  promotedContactId String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  organization V2Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, dedupeFingerprint])
  @@index([organizationId, domain])
  @@index([organizationId, linkedinUrl])
  @@index([organizationId, lastSeenAt])
  @@index([deletedAt])
}
