}

// One enrollment binds to ONE sender (sticky, B12) so the reply thread stays in
// that mailbox's IMAP for O7 correlation. Idempotent per (org, sequence, lead).
model V2SequenceEnrollment {
  id                            String             @id @default(cuid())
  organizationId                String
  sequenceId                    String
  leadAssignmentId              String
  contactId                     String?
  senderAccountId               String
  status                        V2EnrollmentStatus @default(ACTIVE)
  currentStepOrdinal            Int                @default(0)
  haltReason                    String?
  nextStepAt                    DateTime?
  outreachProfileId             String?
  recipientEmailSnapshot        String?
  timezoneSnapshot              String?
  renderContextSnapshotJson     Json?
  outreachProfileFingerprint    String?
  qualificationOverrideReason   String?
  qualificationOverrideByUserId String?
  qualificationOverrideAt       DateTime?
  enrolledByUserId              String?
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt
  deletedAt                     DateTime?

  @@unique([organizationId, sequenceId, leadAssignmentId])
  @@index([organizationId, status, nextStepAt])
  @@index([organizationId, senderAccountId])
  @@index([organizationId, leadAssignmentId])
  @@index([organizationId, outreachProfileId], map: "V2SequenceEnrollment_org_outreachProfile_idx")
  @@index([deletedAt])
  @@index([organizationId, contactId, status], map: "V2SequenceEnrollment_org_contact_status_idx")
}

// An email attachment. Storage is pluggable via a backend seam so the DB-blob default can migrate
// to local disk or S3 later with a data move only (no schema/send-path change): `storageBackend`
// selects the backend, `storageRef` is that backend's key (for DB it is this row's own id), and
// `contentBytes` holds the bytes for the DB backend (null for external backends). Rows are staged on
// upload (messageId null) and linked when the outbound message is created.
model V2EmailAttachment {
  id             String @id @default(cuid())
  organizationId String

  messageId String? // linked to the V2OutreachMessage at send-create; null while staged

  filename  String
  mimeType  String
  sizeBytes Int

  storageBackend String @default("DB") // DB | LOCAL | S3 (migration seam)
  storageRef     String // backend key; for DB backend equals this row id
  contentBytes   Bytes? // DB backend only; null once moved to an external backend

  createdByUserId String?
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?

  @@index([organizationId, messageId])
  @@index([organizationId, createdAt])
  @@index([deletedAt])
}

// One outbound message. Send state machine (B2): QUEUED -> SENDING -> SENT/FAILED/
// BOUNCED. providerMessageId is the high-entropy Message-ID minted at SENDING (B3).
model V2OutreachMessage {
  id             String @id @default(cuid())
  organizationId String

  leadAssignmentId      String
  contactId             String?
  senderAccountId       String
  enrollmentId          String?
  sequenceStepId        String?
  sequenceStepVariantId String?

  idempotencyKey    String // computed before enqueue (B13)
  providerMessageId String? // Message-ID, minted at SENDING (B2/B3)
  inReplyToId       String?

  status           V2OutreachMessageStatus @default(QUEUED)
  sendAttemptToken String?
  sendingAt        DateTime?
  sentAt           DateTime?
  failedAt         DateTime?

  toAddress            String
  subject              String?
  bodyRef              String? // body storage ref (B10); not in list read models
  listUnsubscribeToken String? // RFC 8058 unsubscribe (B4)

  errorCode    String?
  errorMessage String?

  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@unique([organizationId, idempotencyKey])
  @@unique([providerMessageId])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, leadAssignmentId, createdAt])
  @@index([organizationId, sequenceStepVariantId, createdAt], map: "V2OutreachMessage_org_variant_createdAt_idx")
  @@index([senderAccountId, sentAt])
  @@index([deletedAt])
}

// Tenant-owned custom tracking domain. Mutable config uses soft delete.
model V2TrackingDomain {
  id              String                 @id @default(cuid())
  organizationId  String
  hostname        String
  cnameTarget     String
  status          V2TrackingDomainStatus @default(PENDING)
  failureReason   String?
  lastCheckedAt   DateTime?
  verifiedAt      DateTime?
  createdByUserId String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  deletedAt       DateTime?

  @@unique([organizationId, hostname], map: "V2TrackingDomain_org_hostname_key")
  @@index([organizationId, status], map: "V2TrackingDomain_org_status_idx")
  @@index([deletedAt])
}

// Opaque token -> stored HTTP(S) target. Runtime never trusts a target from a request.
model V2OutreachTrackingLink {
