// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  @@unique([id, tenantId], map: "User_id_tenantId_key")
  id          String   @id @default(cuid())
  email       String   @unique
  password    String
  firstName   String
  lastName    String
  role        Role     @default(sdr)
  managerId   String?
  manager     User?    @relation("UserReports", fields: [managerId, tenantId], references: [id, tenantId], onDelete: SetNull)
  reports     User[]   @relation("UserReports")
  avatarUrl   String?
  timezone    String   @default("UTC")
  isActive    Boolean  @default(true)
  /// Bumped whenever a change must invalidate every existing session — password change,
  /// admin reset, deactivate/reactivate, role change, tenant move, or an explicit
  /// "sign out all sessions". The JWT carries the value it was minted with; `getSessionUser`
  /// rejects any token whose value no longer matches. Sessions are stateless JWTs, so this
  /// counter is the only revocation mechanism available.
  authVersion Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  assignedLeads            Lead[]                    @relation("LeadAssignee")
  tasks                    Task[]
  notes                    Note[]
  activities               Activity[]
  emailAccounts            EmailAccount[]
  notifications            Notification[]
  reminders                Reminder[]
  sequences                Sequence[]
  templates                Template[]
  approvedStepCopies       SequenceStepCopy[]
  draftedSequences         SequenceDraftRecord[]
  campaignSdrs             CampaignSdr[]
  auditLogs                AuditLog[]
  aiMemories               AiMemory[]
  importBatches            ImportBatch[]
  createdBookingLinks      BookingLink[]             @relation("BookingLinkCreator")
  sdrMeetings              Meeting[]                 @relation("MeetingSdr")
  outcomeLoggedMeetings    Meeting[]                 @relation("MeetingOutcomeLogger")
  ownedOpportunities       Opportunity[]             @relation("OpportunityOwner")
  createdOpportunities     Opportunity[]             @relation("OpportunityCreator")
  opportunityActivities    OpportunityActivity[]
  leadgenQualified         LeadPoolItem[]            @relation("LeadPoolQualifiedBy")
  leadgenAssigned          LeadPoolItem[]            @relation("LeadPoolAssignedSdr")
  leadgenAssignedBy        LeadPoolItem[]            @relation("LeadPoolAssignedBy")
  campaignLeadRequirements CampaignLeadRequirement[] @relation("LeadRequirementCreatedBy")
  leadgenActivities        LeadgenActivity[]
  generatedReports         ClientReport[]            @relation("ReportGeneratedBy")
  approvedReports          ClientReport[]            @relation("ReportApprovedBy")
  reportExports            ClientReportExport[]
  reportShareLinks         ClientReportShareLink[]
  healthSnapshots          EmailHealthSnapshot[]
  AgentAction              AgentAction[]
  workOrdersCreated        WorkOrder[]               @relation("WorkOrdersCreated")
  approvalsRequested       AgentApprovalRequest[]    @relation("ApprovalRequestedBy")
  approvalsDecided         AgentApprovalRequest[]    @relation("ApprovalDecidedBy")
  apiKeys                  ApiKey[]                  @relation("UserApiKeys")
  ownedContactRelationships ContactIntelligence[]   @relation("ContactRelationshipOwner")
  capturedEvidence          ContactEvidence[]       @relation("EvidenceCapturedBy")
  researchRunsCreated       ResearchRun[]           @relation("ResearchRunCreatedBy")

  @@index([tenantId])
  @@index([tenantId, managerId])
  @@index([tenantId, role, isActive])
}

// ─── Clients & Campaigns ─────────────────────────────────────────────────────

model Client {
  @@unique([id, tenantId], map: "Client_id_tenantId_key")
  id           String       @id @default(cuid())
  name         String
  industry     String
  contactName  String
  contactEmail String
  status       ClientStatus @default(active)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  campaigns     Campaign[]
  bookingLinks  BookingLink[]
  meetings      Meeting[]
  opportunities Opportunity[]
  clientReports ClientReport[]

  @@index([tenantId])
}

model Campaign {
  @@unique([id, tenantId], map: "Campaign_id_tenantId_key")
  id             String         @id @default(cuid())
  clientId       String
  client         Client         @relation(fields: [clientId, tenantId], references: [id, tenantId])
  name           String
  targetVertical String?
  targetGeo      String?
  /// Which rule set scores leads imported for this campaign. Separate from
  /// `CampaignLeadRequirement`, which stays the delivery contract with the client.
  icpVersionId   String?
  icpVersion     IcpVersion?    @relation(fields: [icpVersionId, tenantId], references: [id, tenantId], onDelete: SetNull)
  status         CampaignStatus @default(active)
  startDate      DateTime
  endDate        DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  playbook           CampaignPlaybook?
  leads              Lead[]
  campaignSdrs       CampaignSdr[]
  suppressionEntries SuppressionEntry[]
  importBatches      ImportBatch[]
  bookingLinks       BookingLink[]
  meetings           Meeting[]
  opportunities      Opportunity[]
  leadRequirements   CampaignLeadRequirement[]
  assignedPoolItems  LeadPoolItem[]
  clientReports      ClientReport[]
  emailHealthAlerts  EmailHealthAlert[]
  workOrders         WorkOrder[]
  contactEvidence    ContactEvidence[]
  researchRuns       ResearchRun[]

  @@index([tenantId])
}

model CampaignSdr {
  campaignId String
  userId     String
  campaign   Campaign @relation(fields: [campaignId, tenantId], references: [id, tenantId])
  user       User     @relation(fields: [userId, tenantId], references: [id, tenantId])
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([campaignId, userId])
  @@index([tenantId])
}

// ─── Account (company-level) — Premium Data Model (P8) ──────────────────────

model Account {
  @@unique([id, tenantId], map: "Account_id_tenantId_key")
  id              String   @id @default(cuid())
  name            String
  industry        String?
  website         String?
  linkedIn        String?
  size            Int?
  country         String?
  companyPhone    String?
  staffCountRange String?
  staffCountMin   Int?
  staffCountMax   Int?
  domain          String?

  // Company identity, phase 1: written alongside `name`, not yet unique.
  //
  // `@@unique([tenantId, name])` keys a company on its raw name, so "Công ty TNHH ABC",
  // "CTY TNHH ABC" and "ABC Co.,Ltd" are three Accounts holding three separate sets of leads.
  // `nameNormalized` folds Unicode, strips diacritics and removes Vietnamese legal forms;
  // `canonicalDomain` is the stronger key wherever a website is known. Both are nullable and
  // unconstrained here on purpose — the backfill measures how many Accounts collapse before any
  // uniqueness is enforced, and phase 2 is what tightens it.
  nameNormalized  String?
  canonicalDomain String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contacts              Contact[]
  contactEmployments    ContactEmployment[]
  researchCandidates    ResearchCandidate[]
  researchSnapshots     CompanyResearchSnapshot[]
  intelligenceProfiles  CompanyIntelligenceProfile[]
  leads                 Lead[]
  opportunities         Opportunity[]
  poolItems             LeadPoolItem[]
  researchCache         AccountResearchCache?
  companySignals        CompanySignal[]
  accountPainHypotheses AccountPainHypothesis[]
  personalizationHooks  PersonalizationHook[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, industry])
  @@index([tenantId, country])
  @@index([tenantId, canonicalDomain])
  @@index([tenantId, nameNormalized])
}

// ─── Contact (person-level) — Premium Data Model (P8) ───────────────────────

model Contact {
  @@unique([id, tenantId], map: "Contact_id_tenantId_key")
  id                       String   @id @default(cuid())
  fullName                 String?
  firstName                String
  lastName                 String
  company                  String
  title                    String?
  department               String?
  seniority                String?
  country                  String?
  email                    String
  phone                    String?
  secondaryPhone           String?
  linkedIn                 String?
  whatsApp                 String?
  emailValidation          String?
  emailScore               Int?
  alternateEmail           String?
  alternateEmailValidation String?
  normalizedEmail          String?
  normalizedPhone          String?
  normalizedLinkedIn       String?

  // A contact belongs to a company. Until now the only link was the free-text `company` column, so
  // "who works at this account" could not be answered without matching strings — and the same person
  // at a renamed company looked like two people. `company` stays as a denormalised label; `accountId`
  // is the fact. `normalizedCompany` is what the pool dedupe key is keyed on, so two spellings of one
  // employer stop producing two pool records.
  accountId                String?
  account                  Account? @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: SetNull)
  fullNameNormalized       String?
  normalizedCompany        String?

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  tenantId                 String
  tenant                   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  employments          ContactEmployment[]
  researchCandidates   ResearchCandidate[]
  leadAssignments      Lead[]
  opportunities        Opportunity[]
  poolItems            LeadPoolItem[]
  researchCache        ContactResearchCache?
  personalizationHooks PersonalizationHook[]
  intelligence         ContactIntelligence?
  evidence             ContactEvidence[]

  @@unique([tenantId, normalizedEmail])
  @@index([tenantId])
  @@index([tenantId, country])
  @@index([tenantId, emailValidation])
  @@index([tenantId, accountId])
  @@index([tenantId, normalizedCompany])
}

// ─── ContactEmployment — who worked where, and when ─────────────────────────
//
// `Contact.accountId` answers "where does this person work now". This answers "where have they
// worked", which is what makes a prospect still reachable after they move: the history survives the
// job change instead of being overwritten by it, and a lead sourced two years ago can be recognised
// as the same person at a new employer.
//
// Kept separate from Contact rather than folded into it because one contact legitimately has several
// employments over time, and exactly one of them is current.
model ContactEmployment {
  @@unique([id, tenantId], map: "ContactEmployment_id_tenantId_key")
  id        String    @id @default(cuid())
  contactId String
  contact   Contact   @relation(fields: [contactId, tenantId], references: [id, tenantId], onDelete: Cascade)
  accountId String
  account   Account   @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: Cascade)
  title     String?
  isCurrent Boolean   @default(true)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // One row per person per employer: re-importing the same roster must not stack duplicates.
  @@unique([tenantId, contactId, accountId])
  @@index([tenantId])
  @@index([tenantId, accountId])
  @@index([contactId, isCurrent])
}

// ─── Contact Intelligence (Permanent Derived Asset) ─────────────────────────

model ContactIntelligence {
  @@unique([contactId, tenantId], map: "ContactIntelligence_contactId_tenantId_key")
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contactId String  @unique
  contact   Contact @relation(fields: [contactId, tenantId], references: [id, tenantId], onDelete: Cascade)

  lifecycleState   ContactLifecycleState   @default(discovered)
  qualityClass     ContactQualityClass     @default(untested)
  dataStatus       ContactDataStatus       @default(partial)
  engagementStatus ContactEngagementStatus @default(never_contacted)
  reuseStatus      ContactReuseStatus      @default(ready)

  intrinsicQualityScore Int?
  dataConfidenceScore   Int?
  engagementScore       Int?
  relationshipScore     Int?
  freshnessScore        Int?

  relationshipOwnerId String?
  relationshipOwner   User?   @relation("ContactRelationshipOwner", fields: [relationshipOwnerId, tenantId], references: [id, tenantId], onDelete: SetNull)

  relationshipStrength RelationshipStrength?
  relationshipType     RelationshipType?
  relationshipSince    DateTime?
  lastMeaningfulAt     DateTime?
  nextRelationshipAt   DateTime?

  campaignCount            Int @default(0)
  touchCount               Int @default(0)
  replyCount               Int @default(0)
  meaningfulReplyCount     Int @default(0)
  positiveReplyCount       Int @default(0)
  meetingBookedCount       Int @default(0)
  meetingCompletedCount    Int @default(0)
  acceptedOpportunityCount Int @default(0)
  wonOpportunityCount      Int @default(0)
  referralGivenCount       Int @default(0)

  preferredChannel   String?
  lastVerifiedAt     DateTime?
  lastContactedAt    DateTime?
  lastRepliedAt      DateTime?
  lastMeetingAt      DateTime?
  lastCommercialAt   DateTime?
  lastIntelligenceAt DateTime?

  cooldownUntil   DateTime?
  restrictedUntil DateTime?
  reuseReason     String?

  relationshipSummary String? @db.Text
  commercialSummary   String? @db.Text
  intelligenceSummary String? @db.Text

  scoringVersion String?
  calculatedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([lifecycleState])
  @@index([qualityClass])
  @@index([reuseStatus])
  @@index([relationshipOwnerId])
  @@index([lastVerifiedAt])
  @@index([tenantId, qualityClass])
  @@index([tenantId, reuseStatus])
}

// ─── Contact Evidence Ledger (Append-Only Historical Facts) ─────────────────

model ContactEvidence {
  @@unique([id, tenantId], map: "ContactEvidence_id_tenantId_key")
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId, tenantId], references: [id, tenantId], onDelete: Cascade)

  evidenceType ContactEvidenceType

  key       String
  valueJson Json?
  summary   String? @db.Text

  sourceType  EvidenceSourceType
  sourceId    String?
  sourceModel String?

  clientId      String?
  campaignId    String?
  campaign      Campaign?    @relation(fields: [campaignId, tenantId], references: [id, tenantId], onDelete: SetNull)
  leadId        String?
  lead          Lead?        @relation(fields: [leadId, tenantId], references: [id, tenantId], onDelete: SetNull)
  meetingId     String?
  meeting       Meeting?     @relation(fields: [meetingId, tenantId], references: [id, tenantId], onDelete: SetNull)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId, tenantId], references: [id, tenantId], onDelete: SetNull)
  activityId    String?
  activity      Activity?    @relation(fields: [activityId, tenantId], references: [id, tenantId], onDelete: SetNull)

  capturedById String?
  capturedBy   User?   @relation("EvidenceCapturedBy", fields: [capturedById, tenantId], references: [id, tenantId], onDelete: SetNull)

  confidence     Int?
  humanConfirmed Boolean @default(false)
  aiGenerated    Boolean @default(false)

  ownershipScope EvidenceOwnershipScope @default(telestar)
  reuseScope     EvidenceReuseScope     @default(cross_campaign_allowed)

  observedAt DateTime
  validFrom  DateTime?
  validUntil DateTime?

  supersedesId String?
  supersedes   ContactEvidence?  @relation("EvidenceSupersedes", fields: [supersedesId, tenantId], references: [id, tenantId], onDelete: SetNull)
  supersededBy ContactEvidence[] @relation("EvidenceSupersedes")

  createdAt DateTime @default(now())

  @@index([tenantId, contactId])
  @@index([evidenceType])
  @@index([campaignId])
  @@index([observedAt])
  @@index([tenantId, observedAt])
}

// ─── Leads (assignment-level) — Premium Data Model (P8) ─────────────────────

model Lead {
  @@unique([id, tenantId], map: "Lead_id_tenantId_key")
  id                 String                    @id @default(cuid())
  contactId          String?
  contact            Contact?                  @relation(fields: [contactId, tenantId], references: [id, tenantId], onDelete: SetNull)
  firstName          String
  lastName           String
  company            String
  title              String?
  email              String
  phone              String?
  linkedIn           String?
  whatsApp           String?
  accountId          String?
  account            Account?                  @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: SetNull)
  stage              LeadStage                 @default(new)
  assignedToId       String
  assignedTo         User                      @relation("LeadAssignee", fields: [assignedToId, tenantId], references: [id, tenantId])
  campaignId         String
  campaign           Campaign                  @relation(fields: [campaignId, tenantId], references: [id, tenantId])
  sequenceId         String?
  sequence           Sequence?                 @relation(fields: [sequenceId, tenantId], references: [id, tenantId], onDelete: SetNull)
  sequenceStep       Int?
  sequenceStatus     SequenceEnrollmentStatus?
  timezone           String?
  emailInvalid       Boolean                   @default(false)
  source             String?
  importListName     String?
  emailValidation    String?
  emailScore         Int?
  vendorSource       String?
  tags               String[]
  crmPriorityScore   Priority                  @default(warm)
  engagementScore    Int?
  lastContactedAt    DateTime?
  nextTaskDue        DateTime?
  emailSentCount     Int                       @default(0)
  emailOpenCount     Int                       @default(0)
  emailReplyCount    Int                       @default(0)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  tenantId           String
  tenant             Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  normalizedEmail    String?
  normalizedPhone    String?
  normalizedLinkedIn String?
  archivedAt         DateTime?
  archivedById       String?
  archiveReason      String?

  /// Who or what should be acting on this prospect right now. Independent of `stage` (sales
  /// process) and of `SequenceEnrollment.status` (cadence execution). Written only by the
  /// transition services in `lib/prospects/` — never by a route, tool or worker directly.
  operatingState   ProspectOperatingState @default(unassigned)
  operatingStateAt DateTime?

  tasks                Task[]
  notes                Note[]
  activities           Activity[]
  reminders            Reminder[]
  outboundMessages     OutboundMessage[]
  inboundMessages      InboundMessage[]
  sequenceEnrollments  SequenceEnrollment[]
  importRows           ImportRow[]
  meetings             Meeting[]
  opportunities        Opportunity[]
  poolSources          LeadPoolItem[]       @relation("LeadPoolConverted")
  operatingTransitions ProspectTransition[]
  workOrders           WorkOrder[]
  workOrderLeases      WorkOrderLease[]
  personalizationHooks PersonalizationHook[]
  sequenceDraftRecords SequenceDraftRecord[]
  contactEvidence      ContactEvidence[]

  @@index([stage])
  @@index([assignedToId])
  @@index([campaignId])
  @@index([accountId])
  @@index([crmPriorityScore])
  @@index([engagementScore])
  @@index([contactId])
  @@index([tenantId])
  @@index([tenantId, stage])
  @@index([tenantId, assignedToId])
  @@index([tenantId, crmPriorityScore])
  @@index([tenantId, email])
  @@index([campaignId, stage])
  @@index([campaignId, assignedToId])
  @@index([tenantId, archivedAt])
  @@index([operatingState])
  @@index([tenantId, operatingState])
  @@index([tenantId, campaignId, normalizedEmail])
  @@index([tenantId, importListName])
  sequenceLaunches   SequenceLaunch[]
}

// ─── Sequences ───────────────────────────────────────────────────────────────

model Sequence {
  @@unique([id, tenantId], map: "Sequence_id_tenantId_key")
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  isArchived  Boolean  @default(false)
  createdById String
  createdBy   User     @relation(fields: [createdById, tenantId], references: [id, tenantId])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  steps               SequenceStep[]
  leads               Lead[]
  sequenceLaunches    SequenceLaunch[]
  activities          Activity[]
  sequenceEnrollments SequenceEnrollment[]

  @@index([tenantId])
}

model SequenceStep {
  id                     String    @id @default(cuid())
  sequenceId             String
  sequence               Sequence  @relation(fields: [sequenceId, tenantId], references: [id, tenantId], onDelete: Cascade)
  order                  Int
  channel                Channel
  delayDays              Int       @default(1)
  delayHours             Int       @default(0)
  templateId             String?
  template               Template? @relation(fields: [templateId, tenantId], references: [id, tenantId], onDelete: SetNull)
  instructions           String?
  autoComplete           Boolean   @default(false)
  version                Int       @default(1)
  // Send window: minutes since midnight in the lead's resolved timezone.
  // null = no window restriction (send anytime the cadence allows).
  sendWindowStartMinutes Int?
  sendWindowEndMinutes   Int?
  tenantId               String
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, order])
  @@index([sequenceId])
  @@index([tenantId])
  // Same reason as OutboundMessage above: deleting a Template nulls this column.
  @@index([templateId])
}

// ─── Tasks ───────────────────────────────────────────────────────────────────

model Task {
  id           String       @id @default(cuid())
  leadId       String
  lead         Lead         @relation(fields: [leadId, tenantId], references: [id, tenantId], onDelete: Cascade)
  userId       String
  user         User         @relation(fields: [userId, tenantId], references: [id, tenantId])
  type         TaskType
  title        String
  description  String?
  outcome      String?
  notes        String?
  dueDate      DateTime
  completedAt  DateTime?
  status       TaskStatus   @default(pending)
  sequenceId   String?
  sequenceStep Int?
  // Soft lock claimed by the auto-send cron; CAS via updateMany since the
  // Neon HTTP driver does not support interactive transactions.
  lockedAt     DateTime?
  priority     TaskPriority @default(medium)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([userId])
  @@index([dueDate])
  @@index([status])
  @@index([tenantId])
  @@index([userId, status, dueDate])
  @@index([leadId, status])
  @@index([type, status, dueDate])
}

// ─── Templates ───────────────────────────────────────────────────────────────

model Template {
  @@unique([id, tenantId], map: "Template_id_tenantId_key")
  id          String   @id @default(cuid())
  name        String
  channel     Channel
  subject     String?
  body        String
  category    String?
  createdById String
  createdBy   User     @relation(fields: [createdById, tenantId], references: [id, tenantId])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  sequenceSteps    SequenceStep[]
  abVariants       AbTestVariant[]
  outboundMessages OutboundMessage[]
  attachments      Attachment[]

  @@index([tenantId])
}

model AbTestVariant {
  @@unique([id, tenantId], map: "AbTestVariant_id_tenantId_key")
  id         String   @id @default(cuid())
  templateId String
  template   Template @relation(fields: [templateId, tenantId], references: [id, tenantId], onDelete: Cascade)
  subject    String?
  body       String?
  version    String // "A" | "B"
  /// Running counters, incremented at send. Kept because existing surfaces read them, but they
  /// are a cache: `OutboundMessage.abVariantId` is what a variant's real performance is derived
  /// from, and nothing reconciles these two.
  sentCount  Int      @default(0)
  replyCount Int      @default(0)
  createdAt  DateTime @default(now())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  sends OutboundMessage[]

  @@index([templateId])
  @@index([tenantId])
}

// ─── Notes ───────────────────────────────────────────────────────────────────

model Note {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId, tenantId], references: [id, tenantId], onDelete: Cascade)
  content     String
  createdById String
  createdBy   User     @relation(fields: [createdById, tenantId], references: [id, tenantId])
  isPinned    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([tenantId])
}

// ─── Reminders ───────────────────────────────────────────────────────────────

model Reminder {
  id          String   @id @default(cuid())
  leadId      String?
  lead        Lead?    @relation(fields: [leadId, tenantId], references: [id, tenantId], onDelete: SetNull)
  userId      String
  user        User     @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)
  text        String
  dueAt       DateTime
  isDismissed Boolean  @default(false)
  createdAt   DateTime @default(now())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([dueAt])
  @@index([tenantId])
}

// ─── Activities ──────────────────────────────────────────────────────────────

model Activity {
  @@unique([id, tenantId], map: "Activity_id_tenantId_key")
  id          String       @id @default(cuid())
  /// Deterministic key for writes that must happen exactly once per subject, such as the
  /// single `lead_created` row an import produces for a lead.
  ///
  /// Nullable and unique: Postgres allows many NULLs in a unique index, so ordinary
  /// activities - dozens of `email_sent` rows on one lead - are unaffected, while a keyed
  /// write is guaranteed once by the database rather than by a read-then-write check that
  /// two concurrent workers can both pass.
  idempotencyKey String?   @unique
  userId      String
  user        User         @relation(fields: [userId, tenantId], references: [id, tenantId])
  leadId      String?
  lead        Lead?        @relation(fields: [leadId, tenantId], references: [id, tenantId], onDelete: SetNull)
  sequenceId  String?
  sequence    Sequence?    @relation(fields: [sequenceId, tenantId], references: [id, tenantId], onDelete: SetNull)
  type        ActivityType
  channel     Channel?
  metadata    Json?
  description String?
  createdAt   DateTime     @default(now())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactEvidence ContactEvidence[]

  @@index([userId])
  @@index([leadId])
  @@index([leadId, type, createdAt])
  @@index([tenantId, userId, type, createdAt])
  @@index([type])
  @@index([createdAt])
  @@index([tenantId])
  @@index([userId, type, createdAt])
}

// ─── Email Accounts ──────────────────────────────────────────────────────────

model EmailAccount {
  @@unique([id, tenantId], map: "EmailAccount_id_tenantId_key")
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId, tenantId], references: [id, tenantId])
  email            String
  provider         EmailProvider
  accessToken      String?       @db.Text
  refreshToken     String?       @db.Text
  encAccessToken   String?       @db.Text
  encRefreshToken  String?       @db.Text
  tokenExpiry      DateTime?
  imapServer       String?
  imapPort         Int?
  smtpServer       String?
  smtpPort         Int?
  encPassword      String?       @db.Text
  isActive         Boolean       @default(true)
  lastSyncAt       DateTime?
  syncCursor       String?
  dailySendCount   Int           @default(0)
  dailyCap         Int           @default(80)
  dailySendDate    DateTime?
  hourlySendWindow Int           @default(0)
  signature        String?       @db.Text

  // ── Deliverability / health ──
  // healthScore + healthLevel are a denormalised cache written by the hourly
  // email-health cron. Live tables recompute from source rows; these exist so a
  // list view can sort and filter without aggregating.
  healthScore       Int?
  healthLevel       EmailHealthLevel?
  lastHealthCheckAt DateTime?
  // Manager-set pause. Non-null hard-blocks the send worker (workers/email.ts).
  sendPausedAt      DateTime?
  sendPausedById    String?
  sendPauseReason   String?

  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  tenantId         String
  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outboundMessages OutboundMessage[]
  inboundMessages  InboundMessage[]
  healthSnapshots  EmailHealthSnapshot[]
  healthAlerts     EmailHealthAlert[]

  @@index([userId])
  @@index([tenantId])
  @@index([tenantId, healthLevel])
}

// ─── Notifications ───────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)
  type      String
  title     String?
  text      String
  linkTo    String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([tenantId])
}

// ─── Audit Logs ──────────────────────────────────────────────────────────────

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: SetNull)
  action        String // e.g. "update_lead", "create_lead", "connect_email"
  tableName     String
  recordId      String
  changedFields Json? // { "field": { "old": "x", "new": "y" } }
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tableName, recordId])
  @@index([createdAt])
  @@index([tenantId])
  @@index([tenantId, action, createdAt])
}

// ─── Job Runs (durable mirror for BullMQ) ─────────────────────────────────────

model JobRun {
  id           String    @id @default(cuid())
  queueName    String
  jobName      String
  bullJobId    String?
  dedupeKey    String    @unique
  status       String    @default("queued") // queued | active | completed | failed
  progress     Json?
  result       Json?
  failedReason String?
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3)
  enqueuedAt   DateTime  @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([queueName, status])
  @@index([dedupeKey])
  @@index([tenantId])
}

// ─── Outbound Messages ───────────────────────────────────────────────────────

model OutboundMessage {
  id                String       @id @default(cuid())
  leadId            String
  lead              Lead         @relation(fields: [leadId, tenantId], references: [id, tenantId])
  accountId         String
  account           EmailAccount @relation(fields: [accountId, tenantId], references: [id, tenantId])
  templateId        String?
  template          Template?    @relation(fields: [templateId, tenantId], references: [id, tenantId], onDelete: SetNull)

  /// Which A/B variant produced these words, recorded at send time.
  ///
  /// Selection is deterministic (`buildJitterSeed` + `deterministicOffset`), so it *could* be
  /// recomputed — and that is exactly why it is stored instead. Recomputation would silently
  /// change the historical answer the day the seed inputs, the variant set or the tie-break
  /// change, and re-deciding what an already-sent message was is not reporting. Null covers
  /// every send with no A/B pair, and every send whose copy was approved per prospect — an
  /// approval overrides variant selection, so attributing it to a variant would be a lie.
  abVariantId       String?
  abVariant         AbTestVariant? @relation(fields: [abVariantId, tenantId], references: [id, tenantId], onDelete: SetNull)
  /// The cadence and step this send belongs to, denormalised so variant reporting does not have
  /// to walk back through the task that may since have been completed, reassigned or deleted.
  sequenceId        String?
  sequenceStepOrder Int?

  to                String
  subject           String?
  body              String?
  providerMessageId String?
  // Derived from durable ids only (see lib/email/idempotency.ts) — never from the
  // subject, which is re-rendered on every attempt.
  idempotencyKey    String       @unique
  // pending | sending | sent | failed | reconciliation_required | permanently_failed | bounced
  // Only `pending` and `failed` may be claimed by a worker. `sending` means a provider
  // call may be in flight; `reconciliation_required` means its outcome is unknown. Neither
  // is ever resent — see workers/email.ts.
  status            String       @default("pending")
  errorMessage      String?
  /**
   * Set by the compare-and-set claim that moves pending/failed -> sending.
   */
  claimedAt         DateTime?
  /**
   * Incremented by the claim, so a repeatedly-ambiguous send is visible to an operator.
   */
  attemptCount      Int          @default(0)
  sentAt            DateTime?
  openedAt          DateTime? // NOTE: no writer exists — there is no open-tracking pixel route.
  repliedAt         DateTime?
  bouncedAt         DateTime?
  bounceType        String? // hard | soft — set by workers/sync.ts handleApplyBounce
  tenantId          String
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([leadId])
  @@index([accountId])
  @@index([status])
  @@index([idempotencyKey])
  // Deleting a Template or an AbTestVariant sets these to NULL on every matching row. Without
  // an index that is a full scan of this table, which is one of the largest in the schema, on
  // an action a user can take from the UI. Measured 2026-08-23: 72 foreign keys in this schema
  // have no index on the child column, but only these and SequenceStep.templateId point at a
  // parent the application actually deletes — the rest guard deletes that only tests and the
  // purge script perform, and indexing those would be write amplification for nothing.
  @@index([templateId])
  @@index([abVariantId])
  @@index([providerMessageId])
  @@index([tenantId])
  // Deliverability rollups: per-inbox 24h/7d windows, and tenant-wide status slices.
  @@index([accountId, sentAt])
  @@index([tenantId, status, sentAt])
  // Bounce correlation: most-recent sent message to an address on an account.
  @@index([accountId, to, status])
  // Reconciliation pass: ambiguous or stale sends, scanned by status then age.
  @@index([status, claimedAt])
  // Variant reporting: every send of one variant, and the per-lead lookup that attributes an
  // outcome back to the message the prospect was answering.
  @@index([tenantId, abVariantId])
  @@index([leadId, sentAt])
}

// ─── Suppression Entries ─────────────────────────────────────────────────────

model SuppressionEntry {
  id         String    @id @default(cuid())
  email      String?
  domain     String?
  company    String?
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId, tenantId], references: [id, tenantId], onDelete: SetNull)
  reason     String // hard_bounce | spam | manual | unsubscribed
  createdAt  DateTime  @default(now())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email, campaignId])
  @@unique([tenantId, domain, campaignId])
  @@unique([tenantId, company, campaignId])
  @@index([email])
  @@index([domain])
  @@index([campaignId])
  @@index([tenantId])
  // Suppression-growth metric for the deliverability dashboard.
  @@index([tenantId, createdAt])
}

// ─── Sequence Enrollments ────────────────────────────────────────────────────

model SequenceEnrollment {
  @@unique([id, tenantId], map: "SequenceEnrollment_id_tenantId_key")
  id               String                   @id @default(cuid())
  leadId           String
  lead             Lead                     @relation(fields: [leadId, tenantId], references: [id, tenantId])
  sequenceId       String
  sequence         Sequence                 @relation(fields: [sequenceId, tenantId], references: [id, tenantId])
  status           SequenceEnrollmentStatus @default(active)
  /// "<tenantId>:<leadId>" while this enrollment occupies the lead (active or paused); null once
  /// it reaches a terminal status. The unique index below is what makes "one occupying
  /// enrollment per lead" a database fact. Normal UNIQUE semantics allow many NULLs, so terminal
  /// rows never collide — see lib/sequences/occupancy.ts.
  occupancyKey     String?                  @unique
  currentStep      Int                      @default(1)
  startedAt        DateTime                 @default(now())
  completedAt      DateTime?
  // Automation runtime fields (Phase 3)
  nextActionAt     DateTime? // When the next automated action is scheduled
  pausedReason     String? // reply|hard_bounce|soft_bounce|meeting_booked|manual|email_health|campaign_paused|mailbox_unavailable
  lastTransitionAt DateTime? // Last time status/state changed
  lastEvaluatedAt  DateTime? // Last time eligibility was evaluated
  tenantId         String
  tenant           Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  stepCopies SequenceStepCopy[]

  @@index([leadId])
  @@index([sequenceId])
  @@index([status])
  @@index([tenantId])
  @@index([nextActionAt]) // For maintenance worker scheduling queries
  @@index([status, nextActionAt]) // Active enrollments due for action
}

/// Approved, prospect-facing copy for one step of one enrollment occurrence.
///
/// Personalization is prepared and approved at **design** time and stored here; execution reads
/// it. The sequence worker therefore never asks a model what to say, and an AI provider being
/// down cannot change what an already-approved cadence sends. Absent a row, the step falls back
/// to its shared `Template` — so this is additive and no existing cadence changes behaviour.
///
/// Keyed by the occurrence rather than the lead: a replacement cadence is a different
/// conversation and must not inherit the copy approved for the one it replaced.
model SequenceStepCopy {
  id           String             @id @default(cuid())
  enrollmentId String
  enrollment   SequenceEnrollment @relation(fields: [enrollmentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  /// Matches `SequenceStep.order`, not a step id: the builder reconciles steps by id but the
  /// cadence position is what an enrollment's `currentStep` names.
  stepOrder    Int
  subject      String?
  body         String
  /// Evidence rows this copy cites, carried from the grounded draft for audit.
  citedEvidenceIds String[]
  /// False when the deterministic evidence-only fallback produced this copy.
  aiGenerated  Boolean            @default(false)
  approvedAt   DateTime           @default(now())
  approvedById String?
  approvedBy   User?              @relation(fields: [approvedById, tenantId], references: [id, tenantId], onDelete: SetNull)
  createdAt    DateTime           @default(now())
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, stepOrder])
  @@index([tenantId])
}

/// The structured outreach draft produced at `sequence_design` time, kept so the launch that
/// sends it can be planned from it later.
///
/// `planWorkOrderSteps` calls no provider by contract — it reads the database and returns planned
/// tool calls. A draft that lived only in the return value of `draftSequenceForLead` was therefore
/// unreachable by the order that sends it, which is why every cadence used its shared template.
///
/// Keyed by lead, not by occurrence: this is the *current* proposal for a prospect, not a record
/// of what was sent. Re-drafting replaces it. The durable record of approved wording is the
/// `AgentApprovalRequest.args` a human signed, and then `SequenceStepCopy` on the enrollment.
model SequenceDraftRecord {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId   String
  lead     Lead   @relation(fields: [leadId, tenantId], references: [id, tenantId], onDelete: Cascade)

  /// A `DraftChannel` from `lib/research/sequenceDrafts.ts`.
  channel String
  /// `SequenceDraftStep[]` — order, channel, delayDays, subject, body, citedEvidenceIds.
  steps   Json

  /// True only when every claim in every step is backed by valid, in-run evidence.
  grounded        Boolean
  groundingReason String?
  /// False when the deterministic evidence-only fallback produced this draft.
  aiGenerated     Boolean  @default(true)
  skillModules    String[]
  citedEvidenceIds String[]

  /// Provenance, for cost attribution and for tracing a draft back to the run that made it.
  aiCallId    String?
  workOrderId String?

  draftedById String?
  draftedBy   User?    @relation(fields: [draftedById, tenantId], references: [id, tenantId], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, leadId])
  @@index([tenantId])
}

// ─── Import ──────────────────────────────────────────────────────────────────

model ImportBatch {
  @@unique([id, tenantId], map: "ImportBatch_id_tenantId_key")
  id         String         @id @default(cuid())
  campaignId String?
  campaign   Campaign?      @relation(fields: [campaignId, tenantId], references: [id, tenantId], onDelete: SetNull)
  targetType String         @default("lead") // lead | pool
  userId     String
  user       User           @relation(fields: [userId, tenantId], references: [id, tenantId])
  filename   String?
  totalRows  Int            @default(0)
  parsedRows Int            @default(0)
  errorRows  Int            @default(0)
  status     String         @default("pending") // pending | parsing | parsed | committing | committed | failed
  errorFile  String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  tenantId   String
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  importRows ImportRow[]
  poolItems  LeadPoolItem[]

  @@index([campaignId])
  @@index([userId])
  @@index([status])
  @@index([targetType])
  @@index([tenantId])
}

model ImportRow {
  id         String        @id @default(cuid())
  batchId    String
  batch      ImportBatch   @relation(fields: [batchId, tenantId], references: [id, tenantId], onDelete: Cascade)
  rowIndex   Int
  data       Json
  errors     Json?
  status     String        @default("pending") // pending | valid | error | imported
  leadId     String?
  lead       Lead?         @relation(fields: [leadId, tenantId], references: [id, tenantId], onDelete: SetNull)
  poolItemId String?
  poolItem   LeadPoolItem? @relation(fields: [poolItemId, tenantId], references: [id, tenantId], onDelete: SetNull)
  createdAt  DateTime      @default(now())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([status])
  @@index([poolItemId])
  @@index([tenantId])
}

// ─── AI SDR Assistant — Per-User Memory ─────────────────────────────────────

model AiMemory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)
  memory    String
  createdAt DateTime @default(now())
  tenantId  String

  @@index([userId])
  @@index([tenantId])
}

// ─── Booking Links ───────────────────────────────────────────────────────────

model BookingLink {
  @@unique([id, tenantId], map: "BookingLink_id_tenantId_key")
  id                 String              @id @default(cuid())
  clientId           String
  client             Client              @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Cascade)
  campaignId         String?
  campaign           Campaign?           @relation(fields: [campaignId, tenantId], references: [id, tenantId], onDelete: Cascade)
  name               String
  url                String              @db.Text
  provider           BookingLinkProvider @default(other)
  ownerName          String?
  ownerEmail         String?
  timezone           String              @default("UTC")
  durationMins       Int                 @default(30)
  instructions       String?             @db.Text
  qualificationNotes String?             @db.Text
  isDefault          Boolean             @default(false)
  isActive           Boolean             @default(true)
  createdById        String?
  createdBy          User?               @relation("BookingLinkCreator", fields: [createdById, tenantId], references: [id, tenantId], onDelete: SetNull)
  meetings           Meeting[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tenantId           String
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([clientId])
  @@index([campaignId])
  @@index([clientId, isDefault])
  @@index([campaignId, isDefault])
  @@index([isActive])
}

// ─── Meetings ────────────────────────────────────────────────────────────────

model Meeting {
  @@unique([id, tenantId], map: "Meeting_id_tenantId_key")
  id                      String          @id @default(cuid())
  leadId                  String
