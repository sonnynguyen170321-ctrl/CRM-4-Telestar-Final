generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  director
  floor_manager
  team_lead
  sdr
  leadgen_manager
  leadgen
}

enum LeadStage {
  new
  sequence_active
  replied
  meeting_booked
  won
  lost
}

enum Priority {
  hot
  warm
  cold
}

enum Channel {
  email
  phone
  linkedin
  whatsapp
}

enum TaskType {
  email
  phone
  linkedin
  whatsapp
  manual
}

enum TaskStatus {
  pending
  completed
  skipped
}

enum TaskPriority {
  high
  medium
  low
}

enum ActivityType {
  email_sent
  call_made
  call_logged
  linkedin_sent
  linkedin_touch
  whatsapp_sent
  whatsapp_message
  note_added
  stage_changed
  task_completed
  task_skipped
  lead_created
  meeting_booked
  booking_link_sent
  meeting_outcome_logged
  meeting_cancelled
  meeting_rescheduled
  sequence_enrolled
  sequence_completed
  sequence_unenrolled
  sequence_deferred
  email_task_completed
  lead_reassigned
  email_replied
  email_bounced
  prospect_handed_off
  prospect_reengagement_eligible
  prospect_handed_back
  prospect_ai_reengagement_started
}

/// Who or what should be acting on this prospect right now.
///
/// Distinct from `Lead.stage` (where they are in the sales process) and from
/// `SequenceEnrollment.status` (where the cadence is). All three carry different,
/// non-redundant information — see docs/revenue-ai/ARCHITECTURE.md §4.
enum ProspectOperatingState {
  unassigned
  researching
  ready_for_outreach
  ai_managed
  human_attention
  human_managed
  waiting_for_prospect
  reengagement_eligible
  ai_reengagement
  completed
}

enum ClientStatus {
  active
  paused
  churned
}

enum CampaignStatus {
  active
  paused
  completed
}

enum EmailProvider {
  gmail
  outlook
  imap_smtp
}

enum SequenceEnrollmentStatus {
  active
  paused
  completed
  unenrolled
}

enum BookingLinkProvider {
  calendly
  google_calendar
  hubspot
  microsoft_bookings
  salesloft
  other
}

enum MeetingStatus {
  link_sent
  scheduled
  completed
  no_show
  cancelled
  rescheduled
}

enum MeetingOutcome {
  qualified_opportunity
  completed_not_qualified
  no_show
  cancelled
  rescheduled
  no_decision
  other
}

enum OpportunityStage {
  pending_client_review
  accepted_by_client
  discovery
  proposal
  negotiation
  won
  lost
  nurture
}

enum OpportunityStatus {
  open
  won
  lost
  rejected
  archived
}

enum HandoffStatus {
  pending
  accepted
  rejected
  needs_more_info
}

enum OpportunitySource {
  meeting_outcome
  manual
  import
}

enum LostReason {
  no_budget
  no_authority
  no_need
  no_timeline
  wrong_icp
  wrong_persona
  duplicate
  competitor
  unresponsive
  client_rejected
  other
}

enum OpportunityActivityType {
  created
  stage_changed
  value_updated
  handoff_submitted
  client_accepted
  client_rejected
  note_added
  next_step_updated
  closed_won
  closed_lost
}

// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String
  firstName   String
  lastName    String
  role        Role     @default(sdr)
  managerId   String?
  manager     User?    @relation("UserReports", fields: [managerId], references: [id])
  reports     User[]   @relation("UserReports")
  avatarUrl   String?
  timezone    String   @default("UTC")
  isActive    Boolean  @default(true)
  /// Bumped whenever a change must invalidate every existing session — password change,
  /// admin reset, deactivate/reactivate, role change, tenant move, or an explicit
  /// "sign out all sessions". The JWT carries the value it was minted with; `getSessionUser`
  /// rejects any token whose value no longer matches. Sessions are stateless JWTs, so this
  /// counter is the only revocation mechanism available.
  authVersion Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  assignedLeads            Lead[]                    @relation("LeadAssignee")
  tasks                    Task[]
  notes                    Note[]
  activities               Activity[]
  emailAccounts            EmailAccount[]
  notifications            Notification[]
  reminders                Reminder[]
  sequences                Sequence[]
  templates                Template[]
  campaignSdrs             CampaignSdr[]
  auditLogs                AuditLog[]
  aiMemories               AiMemory[]
  importBatches            ImportBatch[]
  createdBookingLinks      BookingLink[]             @relation("BookingLinkCreator")
  sdrMeetings              Meeting[]                 @relation("MeetingSdr")
  outcomeLoggedMeetings    Meeting[]                 @relation("MeetingOutcomeLogger")
  ownedOpportunities       Opportunity[]             @relation("OpportunityOwner")
  createdOpportunities     Opportunity[]             @relation("OpportunityCreator")
  opportunityActivities    OpportunityActivity[]
  leadgenQualified         LeadPoolItem[]            @relation("LeadPoolQualifiedBy")
  leadgenAssigned          LeadPoolItem[]            @relation("LeadPoolAssignedSdr")
  leadgenAssignedBy        LeadPoolItem[]            @relation("LeadPoolAssignedBy")
  campaignLeadRequirements CampaignLeadRequirement[] @relation("LeadRequirementCreatedBy")
  leadgenActivities        LeadgenActivity[]
  generatedReports         ClientReport[]            @relation("ReportGeneratedBy")
  approvedReports          ClientReport[]            @relation("ReportApprovedBy")
  reportExports            ClientReportExport[]
  reportShareLinks         ClientReportShareLink[]
  healthSnapshots          EmailHealthSnapshot[]
  AgentAction              AgentAction[]
  workOrdersCreated        WorkOrder[]               @relation("WorkOrdersCreated")
  approvalsRequested       AgentApprovalRequest[]    @relation("ApprovalRequestedBy")
  approvalsDecided         AgentApprovalRequest[]    @relation("ApprovalDecidedBy")

  @@index([tenantId])
  @@index([tenantId, managerId])
  @@index([tenantId, role, isActive])
}

// ─── Clients & Campaigns ─────────────────────────────────────────────────────

model Client {
  id           String       @id @default(cuid())
  name         String
  industry     String
  contactName  String
  contactEmail String
  status       ClientStatus @default(active)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  campaigns     Campaign[]
  bookingLinks  BookingLink[]
  meetings      Meeting[]
  opportunities Opportunity[]
  clientReports ClientReport[]

  @@index([tenantId])
}

model Campaign {
  id             String         @id @default(cuid())
  clientId       String
  client         Client         @relation(fields: [clientId], references: [id])
  name           String
  targetVertical String?
  targetGeo      String?
  status         CampaignStatus @default(active)
  startDate      DateTime
  endDate        DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  playbook           CampaignPlaybook?
  leads              Lead[]
  campaignSdrs       CampaignSdr[]
  suppressionEntries SuppressionEntry[]
  importBatches      ImportBatch[]
  bookingLinks       BookingLink[]
  meetings           Meeting[]
  opportunities      Opportunity[]
  leadRequirements   CampaignLeadRequirement[]
  assignedPoolItems  LeadPoolItem[]
  clientReports      ClientReport[]
  emailHealthAlerts  EmailHealthAlert[]
  workOrders         WorkOrder[]

  @@index([tenantId])
}

model CampaignSdr {
  campaignId String
  userId     String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([campaignId, userId])
  @@index([tenantId])
}

// ─── Account (company-level) — Premium Data Model (P8) ──────────────────────

model Account {
  id              String   @id @default(cuid())
  name            String
  industry        String?
  website         String?
  linkedIn        String?
  size            Int?
  country         String?
  companyPhone    String?
  staffCountRange String?
  staffCountMin   Int?
  staffCountMax   Int?
  domain          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  leads         Lead[]
  opportunities Opportunity[]
  poolItems     LeadPoolItem[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, industry])
  @@index([tenantId, country])
}

// ─── Contact (person-level) — Premium Data Model (P8) ───────────────────────

model Contact {
  id                       String   @id @default(cuid())
  fullName                 String?
  firstName                String
  lastName                 String
  company                  String
  title                    String?
  department               String?
  seniority                String?
  country                  String?
  email                    String
  phone                    String?
  secondaryPhone           String?
  linkedIn                 String?
  whatsApp                 String?
  emailValidation          String?
  emailScore               Int?
  alternateEmail           String?
  alternateEmailValidation String?
  normalizedEmail          String?
  normalizedPhone          String?
  normalizedLinkedIn       String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  tenantId                 String
  tenant                   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  leadAssignments Lead[]
  opportunities   Opportunity[]
  poolItems       LeadPoolItem[]

  @@unique([tenantId, normalizedEmail])
  @@index([tenantId])
  @@index([tenantId, country])
  @@index([tenantId, emailValidation])
}

// ─── Leads (assignment-level) — Premium Data Model (P8) ─────────────────────

model Lead {
  id                 String                    @id @default(cuid())
  contactId          String?
  contact            Contact?                  @relation(fields: [contactId], references: [id])
  firstName          String
  lastName           String
  company            String
  title              String?
  email              String
  phone              String?
  linkedIn           String?
  whatsApp           String?
  accountId          String?
  account            Account?                  @relation(fields: [accountId], references: [id])
  stage              LeadStage                 @default(new)
  assignedToId       String
  assignedTo         User                      @relation("LeadAssignee", fields: [assignedToId], references: [id])
  campaignId         String
  campaign           Campaign                  @relation(fields: [campaignId], references: [id])
  sequenceId         String?
  sequence           Sequence?                 @relation(fields: [sequenceId], references: [id])
  sequenceStep       Int?
  sequenceStatus     SequenceEnrollmentStatus?
  timezone           String?
  emailInvalid       Boolean                   @default(false)
  source             String?
  importListName     String?
  emailValidation    String?
  emailScore         Int?
  vendorSource       String?
  tags               String[]
  crmPriorityScore   Priority                  @default(warm)
  engagementScore    Int?
  lastContactedAt    DateTime?
  nextTaskDue        DateTime?
  emailSentCount     Int                       @default(0)
  emailOpenCount     Int                       @default(0)
  emailReplyCount    Int                       @default(0)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  tenantId           String
  tenant             Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  normalizedEmail    String?
  normalizedPhone    String?
  normalizedLinkedIn String?
  archivedAt         DateTime?
  archivedById       String?
  archiveReason      String?

  /// Who or what should be acting on this prospect right now. Independent of `stage` (sales
  /// process) and of `SequenceEnrollment.status` (cadence execution). Written only by the
  /// transition services in `lib/prospects/` — never by a route, tool or worker directly.
  operatingState   ProspectOperatingState @default(unassigned)
  operatingStateAt DateTime?

  tasks                Task[]
  notes                Note[]
  activities           Activity[]
  reminders            Reminder[]
  outboundMessages     OutboundMessage[]
  inboundMessages      InboundMessage[]
  sequenceEnrollments  SequenceEnrollment[]
  importRows           ImportRow[]
  meetings             Meeting[]
  opportunities        Opportunity[]
  poolSources          LeadPoolItem[]       @relation("LeadPoolConverted")
  operatingTransitions ProspectTransition[]
  workOrders           WorkOrder[]
  workOrderLeases      WorkOrderLease[]

  @@index([stage])
  @@index([assignedToId])
  @@index([campaignId])
  @@index([accountId])
  @@index([crmPriorityScore])
  @@index([engagementScore])
  @@index([contactId])
  @@index([tenantId])
  @@index([tenantId, stage])
  @@index([tenantId, assignedToId])
  @@index([tenantId, crmPriorityScore])
  @@index([tenantId, email])
  @@index([campaignId, stage])
  @@index([campaignId, assignedToId])
  @@index([tenantId, archivedAt])
  @@index([operatingState])
  @@index([tenantId, operatingState])
  @@index([tenantId, campaignId, normalizedEmail])
  @@index([tenantId, importListName])
}

// ─── Sequences ───────────────────────────────────────────────────────────────

model Sequence {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  isArchived  Boolean  @default(false)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  steps               SequenceStep[]
  leads               Lead[]
  activities          Activity[]
  sequenceEnrollments SequenceEnrollment[]

  @@index([tenantId])
}

model SequenceStep {
  id                     String    @id @default(cuid())
  sequenceId             String
  sequence               Sequence  @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  order                  Int
  channel                Channel
  delayDays              Int       @default(1)
  delayHours             Int       @default(0)
  templateId             String?
  template               Template? @relation(fields: [templateId], references: [id])
  instructions           String?
  autoComplete           Boolean   @default(false)
  version                Int       @default(1)
  // Send window: minutes since midnight in the lead's resolved timezone.
  // null = no window restriction (send anytime the cadence allows).
  sendWindowStartMinutes Int?
  sendWindowEndMinutes   Int?
  tenantId               String
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, order])
  @@index([sequenceId])
  @@index([tenantId])
}

// ─── Tasks ───────────────────────────────────────────────────────────────────

model Task {
  id           String       @id @default(cuid())
  leadId       String
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  type         TaskType
  title        String
  description  String?
  outcome      String?
  notes        String?
  dueDate      DateTime
  completedAt  DateTime?
  status       TaskStatus   @default(pending)
  sequenceId   String?
  sequenceStep Int?
  // Soft lock claimed by the auto-send cron; CAS via updateMany since the
  // Neon HTTP driver does not support interactive transactions.
  lockedAt     DateTime?
  priority     TaskPriority @default(medium)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([userId])
  @@index([dueDate])
  @@index([status])
  @@index([tenantId])
  @@index([userId, status, dueDate])
  @@index([leadId, status])
  @@index([type, status, dueDate])
}

// ─── Templates ───────────────────────────────────────────────────────────────

model Template {
  id          String   @id @default(cuid())
  name        String
  channel     Channel
  subject     String?
  body        String
  category    String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  sequenceSteps    SequenceStep[]
  abVariants       AbTestVariant[]
  outboundMessages OutboundMessage[]
  attachments      Attachment[]

  @@index([tenantId])
}

model AbTestVariant {
  id         String   @id @default(cuid())
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  subject    String?
  body       String?
  version    String // "A" | "B"
  sentCount  Int      @default(0)
  replyCount Int      @default(0)
  createdAt  DateTime @default(now())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([tenantId])
}

// ─── Notes ───────────────────────────────────────────────────────────────────

model Note {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  content     String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  isPinned    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([tenantId])
}

// ─── Reminders ───────────────────────────────────────────────────────────────

model Reminder {
  id          String   @id @default(cuid())
  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text        String
  dueAt       DateTime
  isDismissed Boolean  @default(false)
  createdAt   DateTime @default(now())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([dueAt])
  @@index([tenantId])
}

// ─── Activities ──────────────────────────────────────────────────────────────

model Activity {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  leadId      String?
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  sequenceId  String?
  sequence    Sequence?    @relation(fields: [sequenceId], references: [id])
  type        ActivityType
  channel     Channel?
  metadata    Json?
  description String?
  createdAt   DateTime     @default(now())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([leadId])
  @@index([leadId, type, createdAt])
  @@index([tenantId, userId, type, createdAt])
  @@index([type])
  @@index([createdAt])
  @@index([tenantId])
  @@index([userId, type, createdAt])
}

// ─── Email Accounts ──────────────────────────────────────────────────────────

model EmailAccount {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  email            String
  provider         EmailProvider
  accessToken      String?       @db.Text
  refreshToken     String?       @db.Text
  encAccessToken   String?       @db.Text
  encRefreshToken  String?       @db.Text
  tokenExpiry      DateTime?
  imapServer       String?
  imapPort         Int?
  smtpServer       String?
  smtpPort         Int?
  encPassword      String?       @db.Text
  isActive         Boolean       @default(true)
  lastSyncAt       DateTime?
  syncCursor       String?
  dailySendCount   Int           @default(0)
  dailyCap         Int           @default(80)
  dailySendDate    DateTime?
  hourlySendWindow Int           @default(0)
  signature        String?       @db.Text

  // ── Deliverability / health ──
  // healthScore + healthLevel are a denormalised cache written by the hourly
  // email-health cron. Live tables recompute from source rows; these exist so a
  // list view can sort and filter without aggregating.
  healthScore       Int?
  healthLevel       EmailHealthLevel?
  lastHealthCheckAt DateTime?
  // Manager-set pause. Non-null hard-blocks the send worker (workers/email.ts).
  sendPausedAt      DateTime?
  sendPausedById    String?
  sendPauseReason   String?

  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  tenantId         String
  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outboundMessages OutboundMessage[]
  inboundMessages  InboundMessage[]
  healthSnapshots  EmailHealthSnapshot[]
  healthAlerts     EmailHealthAlert[]

  @@index([userId])
  @@index([tenantId])
  @@index([tenantId, healthLevel])
}

// ─── Notifications ───────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String?
  text      String
  linkTo    String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([tenantId])
}

// ─── Audit Logs ──────────────────────────────────────────────────────────────

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action        String // e.g. "update_lead", "create_lead", "connect_email"
  tableName     String
  recordId      String
  changedFields Json? // { "field": { "old": "x", "new": "y" } }
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tableName, recordId])
  @@index([createdAt])
  @@index([tenantId])
  @@index([tenantId, action, createdAt])
}

// ─── Job Runs (durable mirror for BullMQ) ─────────────────────────────────────

model JobRun {
  id           String    @id @default(cuid())
  queueName    String
  jobName      String
  bullJobId    String?
  dedupeKey    String    @unique
  status       String    @default("queued") // queued | active | completed | failed
  progress     Json?
  result       Json?
  failedReason String?
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3)
  enqueuedAt   DateTime  @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([queueName, status])
  @@index([dedupeKey])
  @@index([tenantId])
}

// ─── Outbound Messages ───────────────────────────────────────────────────────

model OutboundMessage {
  id                String       @id @default(cuid())
  leadId            String
  lead              Lead         @relation(fields: [leadId], references: [id])
  accountId         String
  account           EmailAccount @relation(fields: [accountId], references: [id])
  templateId        String?
  template          Template?    @relation(fields: [templateId], references: [id])
  to                String
  subject           String?
  body              String?
  providerMessageId String?
  // Derived from durable ids only (see lib/email/idempotency.ts) — never from the
  // subject, which is re-rendered on every attempt.
  idempotencyKey    String       @unique
  // pending | sending | sent | failed | reconciliation_required | permanently_failed | bounced
  // Only `pending` and `failed` may be claimed by a worker. `sending` means a provider
  // call may be in flight; `reconciliation_required` means its outcome is unknown. Neither
  // is ever resent — see workers/email.ts.
  status            String       @default("pending")
  errorMessage      String?
  /**
   * Set by the compare-and-set claim that moves pending/failed -> sending.
   */
  claimedAt         DateTime?
  /**
   * Incremented by the claim, so a repeatedly-ambiguous send is visible to an operator.
   */
  attemptCount      Int          @default(0)
  sentAt            DateTime?
  openedAt          DateTime? // NOTE: no writer exists — there is no open-tracking pixel route.
  repliedAt         DateTime?
  bouncedAt         DateTime?
  bounceType        String? // hard | soft — set by workers/sync.ts handleApplyBounce
  tenantId          String
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([leadId])
  @@index([accountId])
  @@index([status])
  @@index([idempotencyKey])
  @@index([providerMessageId])
  @@index([tenantId])
  // Deliverability rollups: per-inbox 24h/7d windows, and tenant-wide status slices.
  @@index([accountId, sentAt])
  @@index([tenantId, status, sentAt])
  // Bounce correlation: most-recent sent message to an address on an account.
  @@index([accountId, to, status])
  // Reconciliation pass: ambiguous or stale sends, scanned by status then age.
  @@index([status, claimedAt])
}

// ─── Suppression Entries ─────────────────────────────────────────────────────

model SuppressionEntry {
