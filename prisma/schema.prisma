// =====================================================================
// O1 â€” Outreach pillar schema (design: docs/v2/plan/V2_OUTREACH_PILLAR_DESIGN.md)
// Schema only: NO send behavior, NO provider call, NO handler. Tenant-scoped;
// repo child-table pattern (plain String FK columns + indexes). Credentials are
// encrypted envelopes (B1), never plaintext. Link A timeline fields on
// V2OutreachActivity (B7). Send state machine on V2OutreachMessage (B2).
// High-entropy providerMessageId for inbound correlation trust (B3/B14).
// =====================================================================

enum V2SenderKind {
  RELAY
  MAILBOX
}

enum V2SenderStatus {
  ACTIVE
  PAUSED
  DEGRADED
  DISABLED
}

enum V2OutreachMessageStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  BOUNCED
  REPLIED
}

enum V2SequenceStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum V2SequenceStepKind {
  EMAIL
  WAIT
  BRANCH
  CALL_TASK
  LINKEDIN
  GOAL
}

enum V2MessageTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum V2EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  HALTED
}

enum V2InboundEventKind {
  REPLY
  BOUNCE_DSN
  COMPLAINT
  UNSUBSCRIBE
  UNCORRELATED
}

enum V2CampaignTimezoneMode {
  LEAD
  CAMPAIGN
  ORGANIZATION
}

enum V2TrackingDomainStatus {
  PENDING
  VERIFIED
  FAILED
  DISABLED
}

enum V2TrackingEventKind {
  OPEN
  CLICK
}

enum V2TrackingBotClassification {
  HUMAN
  BOT
  SUSPECTED
  UNKNOWN
}

// Sender pool. RELAY = high-volume SMTP relay on your domain; MAILBOX = a Gmail /
// Workspace account (warmup). Credentials stored as AES-256-GCM envelopes (B1).
model V2SenderAccount {
  id             String @id @default(cuid())
  organizationId String

  kind        V2SenderKind
  displayName String
  fromAddress String
  fromName    String?
  domain      String

  // Optional HTML signature inserted/appended into outbound bodies (managed in sender settings).
  signatureHtml String?

  smtpHost    String
  smtpPort    Int
  smtpSecure  Boolean @default(true)
  smtpAuthEnc Json // { ciphertext, iv, authTag, keyVersion } â€” never plaintext (B1)

  imapHost          String?
  imapPort          Int?
  imapSecure        Boolean?
  imapAuthEnc       Json? // encrypted envelope (B1)
  returnPathAddress String?

  // S6c: OAuth (XOAUTH2) auth. authMode = PASSWORD (smtp/imapAuthEnc) or OAUTH.
  // oauthRefreshEnc is the encrypted refresh token (B1); never plaintext/logged.
  authMode        String  @default("PASSWORD")
  oauthProvider   String?
  oauthRefreshEnc Json?

  rateLimitPerMinute Int?
  rateLimitPerHour   Int?
  dailyCapTarget     Int  @default(0)
  dailyCapCurrent    Int  @default(0)

  warmupStage     Int       @default(0)
  warmupStartedAt DateTime?

  bounceRate            Float     @default(0)
  complaintRate         Float     @default(0)
  sentCountWindow       Int       @default(0)
  bounceCountWindow     Int       @default(0)
  healthWindowStartedAt DateTime?

  status           V2SenderStatus @default(ACTIVE)
  liveSendEnabled  Boolean        @default(false) // O9 cutover gate
  trackingDomainId String?
  lastSendAt       DateTime?

  // S6b: connection-verification state (SMTP/IMAP). verifiedAt set on a full
  // pass; lastVerifyError holds the fixed failure category on a failed check.
  verifiedAt          DateTime?
  lastVerifyError     String?
  lastVerifyCheckedAt DateTime?

  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([organizationId, status])
  @@index([organizationId, kind, status])
  @@index([organizationId, domain])
  @@index([organizationId, trackingDomainId])
  @@index([deletedAt])
}

// S6c: one-time, tenant-bound OAuth state for the Authorization Code + PKCE flow.
// codeVerifierEnc is the encrypted PKCE verifier (B1). Single-use via consumedAt
// (atomic UPDATE ... WHERE consumedAt IS NULL). Expires fast (~10 min).
model V2OutreachOAuthState {
  id              String    @id @default(cuid())
  organizationId  String
  state           String
  provider        String
  codeVerifierEnc Json
  redirectUri     String
  createdByUserId String?
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@unique([organizationId, state])
  @@index([expiresAt])
}

// Liveness heartbeat for the dedicated worker + IMAP poller daemons. A stale
// (or missing-in-prod) heartbeat blocks live campaign launch â€” the UI is not the
// scheduler, so a dead daemon must not silently swallow sends.
model V2WorkerHeartbeat {
  id         String   @id @default(cuid())
  workerKind String   @unique
  lastBeatAt DateTime
  updatedAt  DateTime @updatedAt
}

// Atomic per-sender-per-day counter for warmup-adjusted cap enforcement (B6).
model V2SenderDailySend {
  id              String   @id @default(cuid())
  organizationId  String
  senderAccountId String
  sendDate        DateTime @db.Date
  count           Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@unique([senderAccountId, sendDate])
  @@index([organizationId, sendDate])
}

