  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email, campaignId])
  @@unique([tenantId, domain, campaignId])
  @@unique([tenantId, company, campaignId])
  @@index([email])
  @@index([domain])
  @@index([campaignId])
  @@index([tenantId])
  // Suppression-growth metric for the deliverability dashboard.
  @@index([tenantId, createdAt])
}

// ─── Sequence Enrollments ────────────────────────────────────────────────────

model SequenceEnrollment {
  id               String                   @id @default(cuid())
  leadId           String
  lead             Lead                     @relation(fields: [leadId], references: [id])
  sequenceId       String
  sequence         Sequence                 @relation(fields: [sequenceId], references: [id])
  status           SequenceEnrollmentStatus @default(active)
  currentStep      Int                      @default(1)
  startedAt        DateTime                 @default(now())
  completedAt      DateTime?
  // Automation runtime fields (Phase 3)
  nextActionAt     DateTime? // When the next automated action is scheduled
  pausedReason     String? // reply|hard_bounce|soft_bounce|meeting_booked|manual|email_health|campaign_paused|mailbox_unavailable
  lastTransitionAt DateTime? // Last time status/state changed
  lastEvaluatedAt  DateTime? // Last time eligibility was evaluated
