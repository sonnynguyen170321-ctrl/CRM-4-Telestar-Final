  idempotencyKey   String
  occurredAt       DateTime @default(now())
  createdAt        DateTime @default(now())

  @@unique([organizationId, idempotencyKey], map: "V2OutreachAuditEvent_org_idempotency_key")
  @@index([organizationId, sequenceId, occurredAt], map: "V2OutreachAuditEvent_org_sequence_time_idx")
  @@index([organizationId, senderAccountId, occurredAt], map: "V2OutreachAuditEvent_org_sender_time_idx")
  @@index([organizationId, leadAssignmentId, occurredAt], map: "V2OutreachAuditEvent_org_lead_time_idx")
  @@index([organizationId, eventKind, occurredAt], map: "V2OutreachAuditEvent_org_kind_time_idx")
}

// Link A timeline projection (B7): exposes leadAssignmentId/occurredAt/eventKind/
// channel so queryLeadTimeline unions it (T1 contract Â§3). eventKind = outreach.*
model V2OutreachActivity {
  id               String   @id @default(cuid())
  organizationId   String
  leadAssignmentId String
  companyId        String?
  contactId        String?
  actorUserId      String?
  channel          String // ActivityChannel (email/linkedin/call/...)
  eventKind        String // "outreach.sent" | "outreach.replied" | "outreach.bounced" | ...
  occurredAt       DateTime
  messageId        String?
  metadataJson     Json?
  createdAt        DateTime @default(now())

  @@index([organizationId, leadAssignmentId, occurredAt])
  @@index([organizationId, occurredAt])
  @@index([organizationId, eventKind])
  @@index([organizationId, contactId, occurredAt], map: "V2OutreachActivity_org_contact_occurredAt_idx")
}

// Inbound mail (IMAP) â€” replaces signed webhooks. Idempotent by (sender, UID);
// acted on only when correlated to a real outbound Message-ID we sent (B3/B14).
model V2InboundMailEvent {
  id                         String             @id @default(cuid())
  organizationId             String
  senderAccountId            String
  mailboxUid                 String
  messageId                  String? // inbound message's own Message-ID
  eventKind                  V2InboundEventKind
  correlatedMessageId        String? // matched outbound providerMessageId
  correlatedLeadAssignmentId String?
  dsnStatus                  String? // e.g. 5.1.1 for hard bounce
  fromAddress                String?
  subject                    String?
  rawHeadersRef              String?
  bodyText                   String? // Unibox: inbound reply body (plain text), for the in-app inbox/thread view
  snippet                    String? // Unibox: short preview (quoted history stripped) for the thread list
  readAt                     DateTime? // Unibox: when an SDR marked this inbound reply read (null = unread)
  processedAt                DateTime?
  createdAt                  DateTime           @default(now())

  @@unique([senderAccountId, mailboxUid])
  @@index([organizationId, eventKind, createdAt])
  @@index([organizationId, correlatedMessageId])
  @@index([organizationId, correlatedLeadAssignmentId, eventKind, createdAt], map: "V2InboundMailEvent_org_lead_kind_time_idx")
  @@index([senderAccountId, createdAt])
}

