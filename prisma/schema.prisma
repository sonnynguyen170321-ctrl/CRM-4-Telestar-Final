  workOrder            WorkOrder?            @relation(fields: [workOrderId, tenantId], references: [id, tenantId], onDelete: SetNull)
  aiCallId             String?
  aiCall               AiCall?               @relation(fields: [aiCallId, tenantId], references: [id, tenantId], onDelete: SetNull)

  hookType             String
