// T2 (contract: docs/v2/plan/V2_ACTIVITY_AND_TIMELINE_CONTRACT.md Â§2).
// Durable home for a single SDR/human activity event attached to a LeadAssignment.
// Uses soft references by plain String columns + indexes (no Prisma @relation /
// FK constraint; referential integrity is app-enforced). Classification fields are
// String, validated at the app boundary against lib/v2/activity-recaps/types.ts
// (single source of truth â€” no duplicated Prisma enums to drift). Insert-only;
// idempotent by sourceActivityHash; soft-deleted; tenant-scoped.
model V2ActivityRecord {
  id             String @id @default(cuid())
  organizationId String

  leadAssignmentId String
  companyId        String
  contactId        String?
  actorUserId      String?

  channel      String // ActivityChannel
  activityType String // ActivityType
  outcome      String // ActivityOutcome
  eventKind    String // timeline discriminator, e.g. "activity.call_connected"

  occurredAt       DateTime
  timestampQuality String // TimestampQuality (provenance of occurredAt)

  sourceActivityHash String // idempotency key (unique per org)
  sourceUploadId     String?
  sourceRowNumber    Int?

  note         String?
  metadataJson Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([organizationId, sourceActivityHash])
  @@index([organizationId, leadAssignmentId, occurredAt])
  @@index([organizationId, companyId, occurredAt])
  @@index([organizationId, occurredAt])
  @@index([deletedAt])
  @@index([organizationId, contactId, occurredAt], map: "V2ActivityRecord_org_contact_occurredAt_idx")
}

