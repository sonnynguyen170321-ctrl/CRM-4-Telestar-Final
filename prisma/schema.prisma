// ─── Durable Webhook Configuration (TEL-P1-032) ──────────────────────────────

/// An outbound webhook subscription.
///
/// This lived only in Redis under `webhooks:configs:<tenantId>` with a 30-day TTL, which broke
/// three ways: it silently expired after 30 days; it did not survive a restart without
/// persistence, a flush or an eviction; and `cacheSet` swallows errors, so creating a webhook
/// with Redis down returned `{ success: true }` and stored nothing.
///
/// That is configuration, not a cached projection of something durable — there was no source of
/// truth to rebuild from, against the `AGENTS.md` invariant that the database is workflow truth
/// and queues are rebuildable from it. This model is that source of truth. Redis may still cache
/// reads; it may never be the authority.
model Webhook {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  url String

  /// The signing secret. Write-only over the API: echoed once on creation and never read back,
  /// because it is enough to forge payloads the receiving system would accept as ours
  /// (TEL-P1-031).
  secret String

  /// Event names from `WebhookEvent` in `lib/webhooks/dispatcher.ts`. A String[] rather than an
  /// enum for the same reason `User.role` is: the set changes with product, and a database enum
  /// turns adding one into a migration. Drift is caught by a test, not by the column type.
  events String[]

  isActive Boolean @default(true)

  /// Last delivery attempt and the status it returned. Nullable because a webhook that has never
  /// fired must be distinguishable from one that fired and failed — `0` would not be.
  lastDeliveryAt DateTime?
  lastStatus     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, isActive])
}

// ─── Durable AI Budget Governance (TEL-P1-015) ───────────────────────────────

/// A tenant's AI spend ledger for one calendar month.
///
/// Budget state used to live in a process-local `Map`. That is not a budget: restarting a
/// process forgot every dollar already spent, and a second replica started again from zero,
/// so N replicas could each spend the full limit. This table is the shared, durable truth.
///
/// ## Why integers
///
/// Amounts are **micro-dollars** (USD x 1_000_000) held in `BigInt`. Floating-point money
/// accumulates error across thousands of small AI calls, and `0.1 + 0.2 != 0.3` is not a
/// property you want in a spend cap. `AiCall.estimatedCostUsd` is `Decimal(12,6)`, so
/// micro-dollars represent it exactly with no rounding.
///
/// ## How the cap actually holds
///
/// Reservation is a **single-statement conditional UPDATE** whose WHERE clause carries the
/// limit check. Postgres takes a row lock for the duration, so concurrent reservers are
/// serialised on this row and the sum can never cross `limitMicros` no matter how many
/// processes try at once. It needs no interactive transaction, which matters because the
/// Neon HTTP driver does not have them.
model TenantAiBudgetPeriod {
  @@unique([id, tenantId], map: "TenantAiBudgetPeriod_id_tenantId_key")
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// UTC calendar month, `YYYY-MM`.
  periodKey String

  /// Hard cap for the period, in micro-dollars.
  limitMicros BigInt
  /// Settled spend, in micro-dollars.
  usedMicros BigInt @default(0)
  /// Currently held reservations, in micro-dollars. Released or reconciled on settlement.
  reservedMicros BigInt @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations TenantAiBudgetReservation[]

  @@unique([tenantId, periodKey])
  @@index([tenantId])
}

/// One in-flight budget hold.
///
/// Reservations are rows rather than memory so a crashed process cannot strand budget
/// forever: a sweep expires holds past `expiresAt` and returns the amount. The sweep marks
/// the row first and decrements the period second, so an interruption between the two
/// leaves the period *over*-reserved rather than under-reserved - the direction that denies
/// spend instead of permitting overspend.
model TenantAiBudgetReservation {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  periodId String
  period   TenantAiBudgetPeriod @relation(fields: [periodId, tenantId], references: [id, tenantId], onDelete: Cascade)

  /// Amount held, in micro-dollars.
  amountMicros BigInt
  /// What the spend was for - 'chat', 'briefing', 'research', ...
  operation String?

  /// `held` | `reconciled` | `released` | `expired`
  status String @default("held")

  createdAt DateTime  @default(now())
  expiresAt DateTime
  settledAt DateTime?
  /// Actual settled cost in micro-dollars, once known.
  settledMicros BigInt?

  @@index([tenantId, status])
  @@index([status, expiresAt])
  @@index([periodId])
}

// ─── API Keys & Developer Access ─────────────────────────────────────────────

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  keyPrefix   String    // e.g. "tl_live_abc123" (displayed in UI)
  keyHash     String    @unique // SHA-256 hex digest of secret token
  scopes      String[]  @default(["leads:read", "leads:write", "calls:write", "activities:write", "enrich:write"])
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation("UserApiKeys", fields: [createdById, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@index([keyHash])
}

// ─── Campaign Playbooks ──────────────────────────────────────────────────────

/// The stable identity for a campaign's operating policy. Holds no policy itself — every
/// rule lives in an immutable `CampaignPlaybookVersion`.
///
/// **This does not define ICP.** `CampaignLeadRequirement` is the source of truth for who
/// leadgen should source and what qualifies; a playbook says how approved outreach should
/// operate. Restating ICP here would create two definitions that disagree, which is worse
/// than one. Where policy needs ICP context it reads the requirement.
model CampaignPlaybook {
  @@unique([id, tenantId], map: "CampaignPlaybook_id_tenantId_key")
  @@unique([campaignId, tenantId], map: "CampaignPlaybook_campaignId_tenantId_key")
  @@unique([currentVersionId, tenantId], map: "CampaignPlaybook_currentVersionId_tenantId_key")
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaignId String   @unique
  campaign   Campaign @relation(fields: [campaignId, tenantId], references: [id, tenantId], onDelete: Cascade)

  name String

  /// The version currently in force. Null until a version is approved and activated —
  /// a campaign with a playbook but no approved policy runs exactly as it did before.
  currentVersionId String?                  @unique
  currentVersion   CampaignPlaybookVersion? @relation("CurrentVersion", fields: [currentVersionId, tenantId], references: [id, tenantId], onDelete: SetNull)

  versions CampaignPlaybookVersion[] @relation("PlaybookVersions")
  proposals PlaybookProposal[]

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

enum CampaignPlaybookVersionStatus {
  draft
  approved
  superseded
}

/// An immutable policy snapshot.
///
/// Approved versions are never edited — a change creates a new draft. That is what makes
/// "did reply rate improve after v4?" answerable: the policy a campaign ran under at any past
/// instant is still on disk exactly as it was.
///
/// Attribution is by activation window. `[activatedAt, supersededAt)` are half-open and never
/// overlap within a playbook, so an event at time T belongs to the version whose window
/// contains T. Phase 6 adds explicit `playbookVersionId` columns on work orders and agent
/// actions, because execution provenance should not rest on time inference once a writer
/// exists — but a column nothing writes is not worth adding before then.
model CampaignPlaybookVersion {
  @@unique([id, tenantId], map: "CampaignPlaybookVersion_id_tenantId_key")
  @@unique([fromProposalId, tenantId], map: "CampaignPlaybookVersion_fromProposalId_tenantId_key")
  id         String           @id @default(cuid())
  tenantId   String
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  playbookId String
  playbook   CampaignPlaybook @relation("PlaybookVersions", fields: [playbookId, tenantId], references: [id, tenantId], onDelete: Cascade)

  /// Human-readable and monotonic per playbook. **Not the authority** — the row id is the
  /// durable reference, and every future FK points at `id`, never at a number.
  versionNumber Int
  status        CampaignPlaybookVersionStatus @default(draft)

  /// The validated policy payload. Structure and required fields are enforced at the domain
  /// boundary by `lib/playbooks/policy.ts`, not by column shape: the sections that matter are
  /// nested (per-situation ghost thresholds, per-channel personalization) and would need a
  /// table each to express as columns, for no query anyone runs.
  rules Json

  createdById String
  createdAt   DateTime @default(now())

  approvedById String?
  approvedAt   DateTime?

  /// Half-open activation window. A draft never carries `activatedAt`.
  activatedAt  DateTime?
  supersededAt DateTime?

  currentFor       CampaignPlaybook?      @relation("CurrentVersion")
  AgentAction      AgentAction[]
  workOrders       WorkOrder[]
  approvalRequests AgentApprovalRequest[]
  /// The proposal whose approval produced this version, when one did. At most one — a proposal
  /// creates exactly one draft, and a draft is created by at most one proposal.
  /// Unique, and that is the whole point: the database refuses a second draft for a proposal
  /// rather than leaving the service's statement ordering as the only thing preventing one.
  fromProposalId   String?                @unique
  fromProposal     PlaybookProposal?      @relation("ProposalCreatedVersion", fields: [fromProposalId, tenantId], references: [id, tenantId], onDelete: SetNull)
  /// Proposals written against this version as their starting point.
  proposalsBasedOn PlaybookProposal[]     @relation("ProposalBaseVersion")

  @@unique([playbookId, versionNumber])
  @@index([tenantId])
  @@index([playbookId, activatedAt])
  @@index([playbookId, status])
}

// ─── Prospect Operating State Transitions ────────────────────────────────────

/// One row per *occurrence* of an ownership transition.
///
/// This is the idempotency ledger, not the audit trail — `Activity` remains the human-readable
/// timeline and every transition writes one. The ledger exists because idempotency needs a
/// unique constraint, and a JSON metadata field cannot carry one.
///
/// `transitionKey` identifies the specific occurrence, never just the lead and the kind. A
/// prospect legitimately moves AI → human → AI → human over a lifetime, so a key of
/// `lead + kind` would permanently block the second genuine handoff. Keys are built from
/// durable event identifiers in `lib/prospects/keys.ts`: the inbound activity for a handoff,
/// the originating handoff for an eligibility episode, the caller's request or work order for a
/// handback or re-engagement activation.
model ProspectTransition {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  leadId String
  lead   Lead   @relation(fields: [leadId, tenantId], references: [id, tenantId], onDelete: Cascade)

  /// 'handoff' | 'reengagement_eligible' | 'handback' | 'ai_reengagement_started'
  kind          String
  /// Identifies this occurrence. Unique per tenant — a retry of the same event finds this row.
  transitionKey String

  fromState ProspectOperatingState
  toState   ProspectOperatingState

  /// Who caused it. Null for system-driven transitions such as an inbound reply.
  actorUserId String?
  /// The work order whose execution caused this transition, when one did. Phase 6a is the
  /// model this column was waiting for, so it carries a real FK now.
  workOrderId String?
  workOrder   WorkOrder? @relation(fields: [workOrderId, tenantId], references: [id, tenantId], onDelete: SetNull)

  /// 'pending' | 'state_applied' | 'completed'
  ///
  /// The row is a durable *claim* on the occurrence, not proof that it finished. A retry that
  /// finds a non-completed row resumes the transition instead of reporting a permanent no-op —
  /// otherwise a crash between the insert and the state write would strand the prospect and
  /// need manual repair, which is not an acceptable normal recovery path.
  status String @default("pending")

  /// Which consequences have already been claimed, so a resume finishes the missing ones
  /// without repeating the done ones. Each entry is claimed by a conditional update before its
  /// effect runs, which is what makes a consequence at-most-once.
  appliedEffects String[] @default([])

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@unique([tenantId, transitionKey])
  @@index([leadId, createdAt])
  @@index([tenantId, kind])
  /// Finding unfinished work is the resume path's main query.
  @@index([status, createdAt])
}

// ─── Agent Capability Autonomy ───────────────────────────────────────────────

/// Per-tenant, per-role override of how much an agent may do on its own for one capability.
///
/// A missing row means "no override" and falls back to `DEFAULT_AUTONOMY` in
/// `lib/agent/capabilities.ts` — absence is not denial, or a tenant that never opened the
/// settings page would have a mute agent.
///
/// This table can only ever make the agent *stricter*. `CAPABILITY_CEILING` caps what a row
/// may loosen (`prospect_reply` is `human_only` everywhere), and CRM role authorization runs
/// underneath regardless — a policy row cannot grant an SDR a right the role does not have.
model AutonomyPolicy {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// A UserRole value. Stored as text so adding a capability never requires an enum migration.
  role       String
  /// An AgentCapability value.
  capability String
  /// 'auto' | 'approval' | 'manager_approval' | 'human_only'
  mode       String

  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, role, capability])
  @@index([tenantId])
}

// ─── Agent Actions (Phase 5) ────────────────────────────────────────────────

model AgentAction {
  @@unique([id, tenantId], map: "AgentAction_id_tenantId_key")
  id                   String                   @id @default(cuid())
  actionKey            String
  tenantId             String
  tenant               Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId               String
  user                 User                     @relation(fields: [userId, tenantId], references: [id, tenantId])
  role                 Role
  capability           String
  tool                 String
  status               String                   @default("pending") // pending | running | completed | failed | refused
  authorizationOutcome String // ALLOW | REQUIRE_USER_APPROVAL | REQUIRE_MANAGER_APPROVAL | DENY
  playbookVersionId    String?
  playbookVersion      CampaignPlaybookVersion? @relation(fields: [playbookVersionId, tenantId], references: [id, tenantId], onDelete: SetNull)
  /// The work order this action executed under, when it ran inside one. Null for interactive
  /// chat, which is a real producer and not a gap to be filled.
  workOrderId          String?
  workOrder            WorkOrder?               @relation(fields: [workOrderId, tenantId], references: [id, tenantId], onDelete: SetNull)
  leadId               String?
  campaignId           String?
  result               Json?
  error                Json?

  attemptCount Int       @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  aiCalls          AiCall[]
  approvalRequests AgentApprovalRequest[]

  @@unique([tenantId, actionKey])
  @@index([tenantId])
  @@index([userId])
  @@index([leadId])
}

// ─── AI Usage Attribution ────────────────────────────────────────────────────

/// One row per outbound call to an AI or research provider.
///
/// Written by `lib/ai/usage.ts` and by nothing else. Recording is best-effort by
/// design: a failure to write this row must never fail the AI operation, and an AI
/// operation failing must never fail the CRM. See docs/revenue-ai/PLAN.md Phase 1.
///
/// A tool-calling exchange produces several rows — one per provider round trip —
/// rather than one aggregate. Aggregating at write time would lose which iteration
/// spent the tokens, which is the question cost review actually asks.
model AiCall {
  @@unique([id, tenantId], map: "AiCall_id_tenantId_key")
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String?
  /// Prospect this call was about, when there is one. No FK: an AiCall is an
  /// accounting record and must outlive an archived or deleted lead.
  leadId      String?
  /// The work order this spend belongs to, when it ran inside one.
  ///
  /// `onDelete: SetNull` rather than cascade, deliberately: an `AiCall` is an accounting record
  /// and must outlive the work order it was spent on, for the same reason `leadId` carries no
  /// FK at all. Losing the row would silently reduce reported spend.
  workOrderId String?
  workOrder   WorkOrder? @relation(fields: [workOrderId, tenantId], references: [id, tenantId], onDelete: SetNull)

  /// Linkage back to the executing AgentAction
  agentActionId String?
  agentAction   AgentAction? @relation(fields: [agentActionId, tenantId], references: [id, tenantId], onDelete: SetNull)

  /// What the call was for — 'chat', 'briefing', 'research', 'draft_reply', …
  operation String
  /// 'groq' | 'gemini' | 'tavily' | 'jina'
  provider  String
  /// Model id for LLM providers; null for search/fetch providers.
  model     String?

  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  /// Billable units for non-token providers (one search, one page fetch).
  searchCredits    Int?

  latencyMs        Int
  /// Estimated, not billed: computed from lib/ai/pricing.ts rates at call time.
  estimatedCostUsd Decimal? @db.Decimal(12, 6)

  /// 'ok' | 'error' | 'rate_limited' | 'unavailable'
  status    String
  errorCode String?

  createdAt DateTime @default(now())

  companySignals        CompanySignal[]
  accountPainHypotheses AccountPainHypothesis[]
  personalizationHooks  PersonalizationHook[]

  @@index([tenantId, createdAt])
  @@index([tenantId, operation])
  @@index([tenantId, provider])
  @@index([userId, createdAt])
  @@index([workOrderId])
}

// ─── Typed Work Orders (Phase 6a) ────────────────────────────────────────────

/// A bounded unit of agent work.
///
/// The **type** is what bounds tool access — `lib/workorders/types.ts` maps each of the nine
/// types to the capabilities it may exercise, and that set is an *additional ceiling only*.
/// A work order can forbid what agent autonomy would have allowed; it can never permit what
/// autonomy forbids. `lib/workorders/authorization.ts` is the single composition point.
///
/// Stored as text rather than enums for `type`, `status` and `pausedReason`, matching
/// `AutonomyPolicy`: adding a work order type should be a code change and a test, not an enum
/// migration coordinated with a deploy.
///
/// ## What this model deliberately does not carry
///
/// Consumption counters (`researchUsed`, `tokensUsed`, `toolCallsUsed`) are **not here**.
/// Phase 6b enforces budgets incrementally and is what will write them; a column nothing writes
/// is not worth adding early — the same reasoning that kept `playbookVersionId` off
/// `CampaignPlaybookVersion`'s dependants until work orders existed to write it.
model WorkOrder {
  @@unique([id, tenantId], map: "WorkOrder_id_tenantId_key")
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// A `WorkOrderType` from `lib/workorders/types.ts`.
  type String
  /// A `WorkOrderStatus`: draft | active | paused | completed | cancelled | failed.
  status String @default("draft")
  /// A `WorkOrderPausedReason` when `status` is `paused`. `budget_exhausted` is a first-class
  /// reason rather than a failure — exhausting a budget is the budget working.
  pausedReason String?

  /// Idempotency for activation. Two deliveries of the same request find the same row instead
  /// of creating a second order against one lead, which the conflict check would then refuse.
  requestKey String

  /// Scope. A batch order is campaign-scoped with no lead; a followup or reply review is
  /// lead-scoped. Both may be set — a lead-scoped order still belongs to its campaign.
  leadId     String?
  lead       Lead?     @relation(fields: [leadId, tenantId], references: [id, tenantId], onDelete: Cascade)
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId, tenantId], references: [id, tenantId], onDelete: Cascade)

  /// **Exact** provenance, resolved once at activation and never recomputed.
  ///
  /// Phase 4 attributed outcomes by activation window because nothing wrote an id. This is the
  /// writer that column was waiting for. Time inference and a stored id must not both be
  /// authorities: where they disagree — a version activated mid-execution — the stored id is
  /// what this order actually ran under.
  playbookVersionId String?
  playbookVersion   CampaignPlaybookVersion? @relation(fields: [playbookVersionId, tenantId], references: [id, tenantId], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("WorkOrdersCreated", fields: [createdById, tenantId], references: [id, tenantId])

  /// Budgets, validated against `BUDGET_BOUNDS` at the domain boundary. Four separate limits
  /// because they fail differently: tokens and research are money at different rates, tool
  /// calls bound blast radius, and duration bounds a stuck run.
  researchBudget       Int
  tokenBudget          Int
  maxToolCalls         Int
  /// Wall-clock seconds from `activatedAt`.
  maxExecutionDuration Int

  /// Consumption, incremented as the work order runs (Phase 6b). Units are fixed in
  /// `lib/workorders/types.ts` and must not drift from what the budgets above mean:
  /// research operations, prompt+completion tokens, and tool invocations *including failures*.
  ///
  /// Denormalised on purpose. The authoritative records are `AiCall` and `AgentAction`, and
  /// `reconcileConsumption` recomputes these from them — but the enforcement check runs before
  /// every tool call, and two aggregate queries per call is a cost the hot path should not pay.
  /// Where they disagree, the ledgers are right.
  ///
  /// There is no counter for duration: it is derived from `activatedAt` and needs no column.
  researchUsed  Int @default(0)
  tokensUsed    Int @default(0)
  toolCallsUsed Int @default(0)

  /// Set once, at the first activation. A pause/resume cycle does not restart it, because
  /// `maxExecutionDuration` is measured from here and a resumed order must not get a fresh clock.
  activatedAt DateTime?
  pausedAt    DateTime?
  /// When the order reached a terminal status — `completed`, `cancelled` **or** `failed`. It is
  /// "ended at" rather than "succeeded at"; `status` is what says which.
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  leases                WorkOrderLease[]
  sequenceLaunches      SequenceLaunch[]
  agentActions          AgentAction[]
  aiCalls               AiCall[]
  transitions           ProspectTransition[]
  companySignals        CompanySignal[]
  accountPainHypotheses AccountPainHypothesis[]
  personalizationHooks  PersonalizationHook[]
  approvalRequests AgentApprovalRequest[]

  @@unique([tenantId, requestKey])
  @@index([tenantId])
  @@index([tenantId, status])
  /// The conflict check's main query: is this lead already held by live work?
  @@index([tenantId, leadId, status])
  @@index([campaignId, status])
}

/// An execution lease on a lead. **Not sales ownership.**
///
/// `Lead.assignedToId` is who the CRM says owns the prospect and this never touches it;
/// `ProspectOperatingState` is who or what is responsible right now and this never touches that
/// either. A lease answers only "which work order may execute against this lead at this
/// instant", and the three concepts stay independent on purpose — a lease expiring must not
/// reassign anybody, and a reassignment must not interrupt a running order.
///
/// ## One row per lead, and why
///
/// `@@unique([tenantId, leadId])` is what makes exclusivity a *constraint* rather than a check.
/// Two concurrent claimants cannot both read "free" and both insert; the database picks one and
/// the loser inspects the winner's row. A service-side check with no constraint behind it would
/// be a race under exactly the conditions leases exist for.
///
/// Only `exclusive`-mode work orders claim. A `shared`-mode order — assistance work that
/// observes and annotates — takes no lease and is blocked by none, because it does not compete:
/// blocking a summary while an SDR works the lead is the opposite of useful. `mode` is stored
/// on the row so the recovery and observability queries can say what class of hold it is
/// without joining back through the order to its type.
model WorkOrderLease {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  leadId String
  lead   Lead   @relation(fields: [leadId, tenantId], references: [id, tenantId], onDelete: Cascade)

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId, tenantId], references: [id, tenantId], onDelete: Cascade)

  /// A `LeaseMode` from `lib/workorders/types.ts`.
  mode String

  /// Fencing identity. Minted fresh on **every** claim and reclaim, preserved across renewals.
  ///
  /// `workOrderId` alone is not enough to fence a stale holder. The dangerous case is not two
  /// different orders — it is *two attempts at the same order*: worker 1 claims for order X and
  /// stalls, the lease expires, worker 2 retries order X and reclaims, then worker 1 wakes. Its
  /// `workOrderId` still matches, so a `workOrderId`-only predicate would let it renew or
  /// release a lease it no longer holds. The token does not match, so it cannot.
  ///
  /// `renew` and `release` both require it. `releaseLeasesForWorkOrder` deliberately does not —
  /// that is the order-ending unwind, where the order reaching a terminal status is authoritative
  /// no matter which attempt currently holds the row.
  claimToken String

  claimedAt DateTime  @default(now())
  renewedAt DateTime?
  /// A lease past this instant is reclaimable by anyone. Expiry is the recovery path for a
  /// worker that died holding it — there is no other way to release a lease whose holder is
  /// gone, and a lease that outlives its process forever is a permanently stuck lead.
  expiresAt DateTime
  /// Set on a clean release. A released row stays for the audit trail and is reclaimable
  /// immediately, rather than being deleted and losing the record that work happened.
  releasedAt DateTime?

  @@unique([tenantId, leadId])
  @@index([tenantId, expiresAt])
  @@index([workOrderId])
}

/// A durable request for a human to approve one specific agent action (Phase 6b).
///
/// Phase 2 gave `REQUIRE_USER_APPROVAL` and `REQUIRE_MANAGER_APPROVAL` a stable vocabulary but
/// no queue, so both stopped execution as if they were refusals. This is that queue. The
/// authorization rules did not change to accommodate it — `lib/agent/authorization.ts` is
/// untouched.
///
/// ## Approval is not a stored decision to execute
///
/// A row here records that a human said yes **at a moment**. It is not a token that bypasses
/// anything: resuming re-runs capability, role, tenant, object, work order and state checks
/// against current truth. A lead reassigned, a policy tightened, a playbook superseded or a
/// prospect handed to a human between approval and resume must still be able to refuse. Storing
/// the decision rather than the permission is what makes that possible.
///
/// `actionKey` is the same stable identity `AgentAction` uses, so "exactly one request per
/// action" is a unique constraint rather than a convention — a retried job finds the pending
/// row instead of asking a second human the same question.
model AgentApprovalRequest {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// The action this approves, identified exactly as `AgentAction.actionKey` identifies it.
  actionKey String

  workOrderId String?
  workOrder   WorkOrder? @relation(fields: [workOrderId, tenantId], references: [id, tenantId], onDelete: Cascade)

  /// The ledger row that was refused, once one exists. Null when the request was raised before
  /// the action was ever attempted.
  agentActionId String?
  agentAction   AgentAction? @relation(fields: [agentActionId, tenantId], references: [id, tenantId], onDelete: SetNull)

  /// The intent, in enough detail for a human to judge it: which capability, which tool, and
  /// the exact arguments that would run. Stored rather than re-derived — a human approves what
  /// they were shown, and re-deriving it later could show them something else.
  capability String
  toolName   String
  args       Json

  leadId            String?
  campaignId        String?
  playbookVersionId String?
  playbookVersion   CampaignPlaybookVersion? @relation(fields: [playbookVersionId, tenantId], references: [id, tenantId], onDelete: SetNull)

  /// 'user' | 'manager' — from the `AuthorizationOutcome` that raised this.
  requiredLevel String
  /// 'pending' | 'approved' | 'rejected' | 'expired'
  status        String @default("pending")

  requestedById String
  requestedBy   User   @relation("ApprovalRequestedBy", fields: [requestedById, tenantId], references: [id, tenantId])

  approvedById String?
  approvedBy   User?   @relation("ApprovalDecidedBy", fields: [approvedById, tenantId], references: [id, tenantId], onDelete: SetNull)
  /// Why it was rejected, or any note the approver left.
  decisionReason String?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  /// Past this instant the request is dead. An approval nobody acted on must not sit pending
  /// forever and then execute against a world that moved on months ago.
  expiresAt  DateTime

  @@unique([tenantId, actionKey])
  @@index([tenantId, status])
  @@index([workOrderId])
  @@index([tenantId, status, expiresAt])
}

model Attachment {
  id          String   @id @default(cuid())
  name        String
  contentType String
  content     String   @db.Text // Base64 encoded file data
  templateId  String
  template    Template @relation(fields: [templateId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdAt   DateTime @default(now())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([tenantId])
}

model InboundMessage {
  id                String       @id @default(cuid())
  accountId         String
  account           EmailAccount @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: Cascade)
  leadId            String?
  lead              Lead?        @relation(fields: [leadId, tenantId], references: [id, tenantId], onDelete: SetNull)
  fromEmail         String
  fromName          String?
  to                String
  subject           String?
  body              String?      @db.Text
  bodyHtml          String?      @db.Text
  providerMessageId String       @unique
  date              DateTime
  isRead            Boolean      @default(false)
  isSpam            Boolean      @default(false)
  isTrash           Boolean      @default(false)
  // Deliverability signals. Bounce notifications used to be discarded at sync time,
  // which made historical bounce rate uncomputable; they are now persisted here.
  isBounce          Boolean      @default(false)
  isReply           Boolean      @default(false)
  bounceType        String? // hard | soft — only set when isBounce
  bouncedRecipient  String? // address that bounced, parsed from the DSN body
  /// Reply classification (Phase 8b). Stored on the message itself rather than in a second
  /// conversation store — the inbound row already *is* the conversation record, and a parallel
  /// table would immediately need reconciling with it.
  /// A = deterministic stop · B = administrative · C = sales engagement · D = ambiguous.
  replyClass        String?
  /// The specific reason inside the class: unsubscribe, ooo, pricing, … See lib/replies/types.ts.
  replyKind         String?
  /// 0–1. Low confidence must never drive aggressive automation, so it is persisted, not derived.
  replyConfidence   Float?
  /// deterministic | ai | fallback — `fallback` means the model was unavailable and the reply
  /// was routed to human review rather than guessed at.
  classificationSource String?
  classifiedAt      DateTime?
  tenantId          String
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt         DateTime     @default(now())

  @@index([accountId])
  @@index([leadId])
  @@index([providerMessageId])
  @@index([tenantId])
  // Manager surface: "reply handoffs" by class within a tenant.
  @@index([tenantId, replyClass])
  // Deliverability rollups: per-inbox windowed reply/bounce/spam counts.
  @@index([accountId, date])
  @@index([tenantId, date])
}

