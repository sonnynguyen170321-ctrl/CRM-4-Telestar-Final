  accountId            String?
  account              Account?              @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: Cascade)
  leadId               String?
  lead                 Lead?                 @relation(fields: [leadId, tenantId], references: [id, tenantId], onDelete: Cascade)
  cacheId              String?
  contactResearchCache ContactResearchCache? @relation(fields: [cacheId, tenantId], references: [id, tenantId], onDelete: SetNull)
  contactResearchRunId String?
