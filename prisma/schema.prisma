  @@index([organizationId, eventKind, occurredAt], map: "V2OutreachTrackingEvent_org_kind_time_idx")
  @@index([organizationId, requestFingerprint], map: "V2OutreachTrackingEvent_org_fingerprint_idx")
}

// Append-only privileged Outreach audit trail. Idempotency prevents retry duplicates.
model V2OutreachAuditEvent {
  id               String   @id @default(cuid())
  organizationId   String
  sequenceId       String?
  senderAccountId  String?
  leadAssignmentId String?
  actorUserId      String?
  eventKind        String
