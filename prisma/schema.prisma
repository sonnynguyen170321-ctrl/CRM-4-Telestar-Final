/// One AI outreach launch attempt, owned by exactly one WorkOrder (Revenue AI Phase 8a).
///
/// Two jobs, both of which need durable state rather than inference:
///
///  1. **Provenance.** An active enrollment on a lead proves nothing about *who* created it —
///     the authenticated `POST /api/sequences/[id]/enroll` route calls the same domain service.
///     A resume must prove the enrollment belongs to this work order's launch, and this row is
///     that proof: `@@unique([tenantId, workOrderId])` plus the enrollment id it created.
///  2. **Convergence.** A launch is a sequence of writes that cannot share a transaction (Neon
///     HTTP has no interactive transactions). `stage` records how far it got, so a retry after a
///     crash resumes instead of guessing from the existence of a Task.
model SequenceLaunch {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  leadId     String
  lead       Lead     @relation(fields: [leadId, tenantId], references: [id, tenantId], onDelete: Cascade)
  sequenceId String
  sequence   Sequence @relation(fields: [sequenceId, tenantId], references: [id, tenantId], onDelete: Cascade)
  /// The work order that owns this launch. One launch per order, enforced below.
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId, tenantId], references: [id, tenantId], onDelete: Cascade)

  /// Set once the enrollment exists. This is the association a resume checks.
  enrollmentId String?
  /// Set once the first step's task exists. Its id is derived from this row, so the Task
  /// primary key is what makes concurrent finalizers collide instead of duplicating.
  taskId       String?

  /// 'claimed' | 'enrolled' | 'state_applied' | 'task_created' | 'completed'
  stage     String   @default("claimed")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, workOrderId])
  @@index([tenantId])
  @@index([tenantId, leadId])
  @@index([tenantId, leadId, sequenceId])
}

// ─── Approved learning (Revenue AI Phase 10) ─────────────────────────────────

/// What a signal says about the thing that produced it.
///
/// Every value here is something the CRM can already observe. There is deliberately no
/// `model_confidence` or `quality_score`: a signal must be a fact someone could argue with by
/// looking at a row, not an opinion the system formed about itself.
enum OutcomeSignalKind {
  /// An AI draft was sent essentially as written.
  draft_accepted
  /// An AI draft was sent after substantial rewriting — the draft was not good enough.
  draft_edited
  /// The prospect replied, and the reply was a sales conversation.
  positive_reply
  /// A meeting was booked with this prospect.
  meeting_booked
  /// A sourced contact was rejected before outreach.
  lead_rejected
  /// A human marked research evidence as not worth using.
  research_irrelevant
  /// The prospect raised an objection.
  objection_raised
  /// A re-engagement follow-up produced a reply.
  reengagement_reply
}

/// One observed outcome, durable and attributable.
///
/// This is the evidence layer under Phase 10. A proposal that cannot point at rows here is an
/// opinion, and a manager approving an opinion is not an approval process.
///
/// ## Why the ids carry no foreign keys
///
/// Same reasoning as `AiCall`: a signal is a *record of something that happened*, and it must
/// outlive an archived lead, a deleted sequence or a campaign that ended. A cascade would quietly
/// reduce the evidence behind an already-approved playbook version, which is the one thing this
/// table exists to prevent. `tenantId` is the exception — a deleted tenant takes its data with it.
model OutcomeSignal {
  @@unique([id, tenantId], map: "OutcomeSignal_id_tenantId_key")
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Identifies the real-world occurrence, so collection is idempotent. A second pass over the
  /// same reply finds this row instead of inflating the count behind a proposal.
  signalKey String

  kind OutcomeSignalKind

  /// +1 this worked, -1 this did not, 0 observed without a verdict. Bounded by the writer.
  direction Int @default(0)

  /// Loose ids, deliberately. See the note above.
  leadId            String?
  campaignId        String?
  sequenceId        String?
  /// Which policy was in force when it happened — the join that makes "did v4 do better" real.
  playbookVersionId String?
  /// Which A/B variant the prospect was answering, when the outcome traces to a send that had
  /// one. A **different axis** from `playbookVersionId`, not a finer grain of it: a playbook
  /// version is the policy the cadence ran under, a variant is which of two wordings this
  /// prospect received under that policy. Both can move independently, and collapsing them
  /// would make "variant B wins" and "the new playbook wins" the same claim.
  abVariantId       String?
  /// The human involved, when one was. AI-observed signals have none.
  actorUserId       String?

  /// One sentence a person can read, written by the collector that produced the row.
  detail   String? @db.Text
  metadata Json?

  occurredAt DateTime
  createdAt  DateTime @default(now())

  evidenceFor PlaybookProposalEvidence[]

  @@unique([tenantId, signalKey])
  @@index([tenantId, kind, occurredAt])
  @@index([tenantId, campaignId, occurredAt])
  @@index([tenantId, playbookVersionId])
  @@index([tenantId, abVariantId, kind])
}

enum PlaybookProposalStatus {
  proposed
  approved
  rejected
  /// A newer proposal about the same pattern replaced this one before anyone decided.
  superseded
}

/// A change the system would like permission to make.
///
/// **Approving one never edits a playbook.** It creates a new *draft* version through
/// `lib/playbooks/versions.ts`, which a human still has to approve and activate. The active
/// version is immutable and stays untouched — `createdVersionId` records the draft that was
/// produced so the trail from evidence to policy is a stored fact rather than an inference.
///
/// No agent may write `status`. Review is a human decision recorded with the reviewer's id.
model PlaybookProposal {
  @@unique([id, tenantId], map: "PlaybookProposal_id_tenantId_key")
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  playbookId String
  playbook   CampaignPlaybook @relation(fields: [playbookId, tenantId], references: [id, tenantId], onDelete: Cascade)
  /// Denormalised for the manager surfaces, which filter by campaign far more than by playbook.
  campaignId String

  /// The version the proposal was written against. Null when the campaign has no approved policy
  /// yet — the proposal then describes a first draft rather than a change to one.
  basedOnVersionId String?
  basedOnVersion   CampaignPlaybookVersion? @relation("ProposalBaseVersion", fields: [basedOnVersionId, tenantId], references: [id, tenantId], onDelete: SetNull)

  /// Identifies the pattern, so a second run updates this row instead of filing a duplicate.
  proposalKey String

  title           String
  /// What the system thinks it is seeing.
  observation     String @db.Text
  /// What it is asking for, in a manager's language.
  suggestedChange String @db.Text

  /// The partial policy override an approval would apply, validated against the playbook
  /// contract before it is stored. It cannot contain ICP — the contract is `.strict()` and ICP
  /// belongs to `CampaignLeadRequirement`.
  proposedRules Json

  /// How many signals stand behind it. Denormalised from the evidence rows for sorting.
  supportCount Int @default(0)

  status PlaybookProposalStatus @default(proposed)

  /// The draft this proposal produced, if any. The link itself lives on the **version** —
  /// `CampaignPlaybookVersion.fromProposalId`, unique — because that is where the rule "one
  /// proposal produces at most one draft" can actually be enforced. A pointer on this side can
  /// only be overwritten, which orphans the first draft rather than refusing the second.
  createdVersion CampaignPlaybookVersion? @relation("ProposalCreatedVersion")

  /// The human who decided. A proposal with `status != proposed` and no reviewer is a defect.
  reviewedById String?
  reviewedAt   DateTime?
  decisionNote String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evidence PlaybookProposalEvidence[]

  @@unique([tenantId, proposalKey])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, campaignId])
}

/// Which observed outcomes a proposal rests on.
///
/// A join table rather than an id array so the evidence behind an approved change cannot drift
/// into naming rows that no longer exist.
/// Joins two tenant-owned tables and, until this column existed, carried no tenant of its own.
/// `supabase/rls.sql` builds its policies by looping over tables that have a `tenantId`, so a
/// table without one received no ENABLE and no policy while `GRANT ... ON ALL TABLES` still
/// gave the application role full DML on it — readable by every tenant.
/// `tests/rls-policy-coverage.test.ts` selects on the same column, so the table that needed the
/// policy was the one table neither the generator nor its coverage test could see.
model PlaybookProposalEvidence {
  id String @id @default(cuid())

  proposalId String
  proposal   PlaybookProposal @relation(fields: [proposalId, tenantId], references: [id, tenantId], onDelete: Cascade)

  signalId String
  signal   OutcomeSignal @relation(fields: [signalId, tenantId], references: [id, tenantId], onDelete: Cascade)

  createdAt DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([proposalId, signalId])
  @@index([signalId])
  @@index([tenantId])
}

// ─── Research discovery + company intelligence ───────────────────────────────
//
// The CRM already has `AccountResearchCache` and `ContactResearchCache`. Those ENRICH a record that
// already exists: given an Account, go and learn more about it. Nothing in the CRM finds companies or
// people it does not already know about, which is the gap these tables close.
//
// The two layers stay side by side on purpose. The caches answer "tell me more about this account";
// these answer "find me accounts worth having".

enum ResearchRunKind {
  company
  contact
}

enum ResearchRunStatus {
  queued
  running
  succeeded
  failed
}

enum ResearchCandidateStatus {
  discovered
  duplicate
  promoted
  dismissed
}

/// Outcome of trying to read a company website. Not a workflow state: it records what the crawler
/// met, which is why `offline` and `blocked` are worth keeping apart from `failed`. Roughly 40% of
/// real company sites refuse a crawler outright, and for those the search chain is the only evidence
/// there is.
enum CompanyCrawlStatus {
  success
  no_website
  offline
  blocked
  timeout
  js_render_required
  partial
  invalid_url
  parked
  not_run
}

enum CompanyIntelligenceProfileStatus {
  placeholder
  extracted
  partial
  failed
}

model ResearchRun {
  @@unique([id, tenantId], map: "ResearchRun_id_tenantId_key")
  id           String            @id @default(cuid())
  kind         ResearchRunKind
  status       ResearchRunStatus @default(queued)
  icpVersionId String?
  icpVersion   IcpVersion?       @relation(fields: [icpVersionId, tenantId], references: [id, tenantId], onDelete: SetNull)
  campaignId   String?
  campaign     Campaign?         @relation(fields: [campaignId, tenantId], references: [id, tenantId], onDelete: SetNull)

  queriesJson Json
  paramsJson  Json?
  /// How far through `queriesJson` the run has got. Persisted so a worker restart resumes instead of
  /// re-running every query and paying for those searches twice.
  queryCursor Int  @default(0)

  discoveredCount Int       @default(0)
  duplicateCount  Int       @default(0)
  errorMessage    String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdById     String?
  createdBy       User?     @relation("ResearchRunCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  candidates       ResearchCandidate[]
  evidence         ResearchEvidence[]
  providerAttempts ResearchProviderAttempt[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model ResearchCandidate {
  @@unique([id, tenantId], map: "ResearchCandidate_id_tenantId_key")
  id     String                  @id @default(cuid())
  runId  String
  run    ResearchRun             @relation(fields: [runId, tenantId], references: [id, tenantId], onDelete: Cascade)
  kind   ResearchRunKind
  status ResearchCandidateStatus @default(discovered)

  name        String
  domain      String?
  linkedinUrl String?
  title       String?
  companyName String?
  location    String?

  /// Where this came from: query, url, snippet, provider. Kept so a reviewer sees the evidence rather
  /// than a bare score.
  sourceJson     Json
  /// Which ICP tokens the result matched.
  matchHintsJson Json
  /// Identity hash. Unique per run so one run cannot list the same company twice, and indexed
  /// tenant-wide so later runs can recognise it.
  dedupeFingerprint String

  fitScore    Int?
  fitReason   String?
  /// "heuristic" or "ai". The deterministic score is the baseline; AI may only refine it within a
  /// bounded window, never replace it.
  fitSource   String?
  emailGuess  String?
  /// GUESSED / VERIFIED / UNKNOWN. A guess must never be treated as deliverable.
  emailStatus String?
  phone       String?
  insightJson Json?
  enrichedAt  DateTime?

  promotedAccountId String?
  promotedAccount   Account? @relation(fields: [promotedAccountId, tenantId], references: [id, tenantId], onDelete: SetNull)
  promotedContactId String?
  promotedContact   Contact? @relation(fields: [promotedContactId, tenantId], references: [id, tenantId], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  evidence         ResearchEvidence[]
  observations     ResearchFieldObservation[]
  providerAttempts ResearchProviderAttempt[]

  @@unique([tenantId, runId, dedupeFingerprint])
  @@index([tenantId])
  @@index([tenantId, dedupeFingerprint])
  @@index([tenantId, runId, status])
  @@index([tenantId, runId, fitScore])
}

/// Everything ever discovered, across runs. Without it the same company is rediscovered and
/// re-enriched every time a similar ICP is searched, and the reviewer is asked about it again.
model ResearchProspect {
  @@unique([id, tenantId], map: "ResearchProspect_id_tenantId_key")
  id                String          @id @default(cuid())
  kind              ResearchRunKind
  dedupeFingerprint String
  domain            String?
  linkedinUrl       String?
  displayName       String
  firstSeenAt       DateTime        @default(now())
  lastSeenAt        DateTime        @default(now())
  timesSeen         Int             @default(1)
  lastRunId         String?

  promotedAccountId String?
  promotedContactId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dedupeFingerprint])
  @@index([tenantId, domain])
  @@index([tenantId, lastSeenAt])
}

/// A single cited observation. `idempotencyKey` is unique so a retried enrichment records the same
/// finding once instead of stacking duplicates behind the same claim.
model ResearchEvidence {
  @@unique([id, tenantId], map: "ResearchEvidence_id_tenantId_key")
  id             String             @id @default(cuid())
  runId          String?
  run            ResearchRun?       @relation(fields: [runId, tenantId], references: [id, tenantId], onDelete: SetNull)
  candidateId    String?
  candidate      ResearchCandidate? @relation(fields: [candidateId, tenantId], references: [id, tenantId], onDelete: SetNull)
  idempotencyKey String
  sourceKind     String
  provider       String?
  sourceUrl      String?
  sourceTitle    String?
  sourceSnippet  String?
  query          String?
  confidence     Int?
  evidenceJson   Json?
  observedAt     DateTime           @default(now())
  createdAt      DateTime           @default(now())
  tenantId       String
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  observations ResearchFieldObservation[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, runId, createdAt])
  @@index([tenantId, candidateId, createdAt])
}

/// One field value with the evidence behind it, so a drawer can show "size: 200-500, because this
/// page said so" rather than an unattributed number.
model ResearchFieldObservation {
  @@unique([id, tenantId], map: "ResearchFieldObservation_id_tenantId_key")
  id          String            @id @default(cuid())
  candidateId String
  candidate   ResearchCandidate @relation(fields: [candidateId, tenantId], references: [id, tenantId], onDelete: Cascade)
  evidenceId  String?
  evidence    ResearchEvidence? @relation(fields: [evidenceId, tenantId], references: [id, tenantId], onDelete: SetNull)
  fieldName   String
  valueText   String?
  valueJson   Json?
  confidence  Int?
  sourceKind  String
  createdAt   DateTime          @default(now())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, candidateId, fieldName])
  @@index([tenantId, evidenceId])
}

/// Per-provider call log. Search costs money, so which provider was asked, whether it answered, and
/// how long it took has to be inspectable rather than inferred from a bill.
model ResearchProviderAttempt {
  @@unique([id, tenantId], map: "ResearchProviderAttempt_id_tenantId_key")
  id           String             @id @default(cuid())
  runId        String?
  run          ResearchRun?       @relation(fields: [runId, tenantId], references: [id, tenantId], onDelete: SetNull)
  candidateId  String?
  candidate    ResearchCandidate? @relation(fields: [candidateId, tenantId], references: [id, tenantId], onDelete: SetNull)
  stage        String
  provider     String
  status       String
  requestJson  Json?
  responseJson Json?
  errorMessage String?
  startedAt    DateTime           @default(now())
  finishedAt   DateTime?
  createdAt    DateTime           @default(now())
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, runId, stage, createdAt])
  @@index([tenantId, provider, status, createdAt])
}

/// Raw result of one crawl of a company site, kept separately from the interpretation of it so a
/// classification change can be re-derived without paying to fetch the pages again.
model CompanyResearchSnapshot {
  @@unique([id, tenantId], map: "CompanyResearchSnapshot_id_tenantId_key")
  id                String             @id @default(cuid())
  accountId         String
  account           Account            @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: Cascade)
  canonicalDomain   String?
  websiteUrl        String?
  status            CompanyCrawlStatus
  httpStatus        Int?
  finalUrl          String?
  redirectChainJson Json?
  pagesFetchedJson  Json?
  searchResultsJson Json?
  rawTextHash       String?
  contentHash       String?
  errorCode         String?
  errorMessage      String?

  /// Bump this when the crawl-or-classify logic changes. It is part of the idempotency key, so
  /// forgetting to bump it means re-running enrichment reuses the old result and the change never
  /// reaches the data. That mistake once hid a classification fix for six weeks.
  researchVersion Int    @default(1)
  idempotencyKey  String

  createdAt DateTime @default(now())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  intelligenceProfiles CompanyIntelligenceProfile[] @relation("ProfileSourceSnapshot")

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, accountId, createdAt])
  @@index([tenantId, canonicalDomain])
  @@index([status])
}

/// What the company actually does, derived from a snapshot: summary, controlled fact tokens, cited
/// evidence, classification and confidence. `industryCategory` is the Axis-1 verdict the ICP scorer
/// reads.
model CompanyIntelligenceProfile {
  @@unique([id, tenantId], map: "CompanyIntelligenceProfile_id_tenantId_key")
  id                       String                           @id @default(cuid())
  accountId                String
  account                  Account                          @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: Cascade)
  canonicalDomain          String?
  sourceResearchSnapshotId String?
  sourceResearchSnapshot   CompanyResearchSnapshot?         @relation("ProfileSourceSnapshot", fields: [sourceResearchSnapshotId, tenantId], references: [id, tenantId], onDelete: SetNull)
  companySummary           String?
  factsJson                Json?
  evidenceItemsJson        Json?
  classificationJson       Json?
  sourceCoverageJson       Json?
  riskSignalsJson          Json?
  confidenceJson           Json?
  industryCategory         String?
  profileStatus            CompanyIntelligenceProfileStatus
  staleAt                  DateTime?
  researchVersion          Int                              @default(1)
  idempotencyKey           String

  createdAt DateTime @default(now())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, accountId, researchVersion])
  @@index([tenantId, accountId, createdAt])
  @@index([tenantId, industryCategory])
  @@index([profileStatus])
}
