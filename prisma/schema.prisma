generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UploadJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum Qualification {
  QUALIFIED
  UNQUALIFIED
  UNCERTAIN
}

enum ReviewState {
  UNREVIEWED
  NEEDS_REVIEW
  REVIEWED
}

enum CompanyType {
  NOT_RELEVANT        @map("Not Relevant")
  PAAS
  SAAS
  CLOUD
  ITO
  DATA_SOLUTION       @map("Data Solution")
  AI_SOLUTION         @map("AI Solution")
  AI_SERVICE          @map("AI Service")
  CYBER_SECURITY      @map("Cyber Security")
  BLOCKCHAIN_SOLUTION @map("Blockchain Solution")
}

enum FeedbackSource {
  LOCAL_UI
  IMPORTED_CSV
  API
}

enum DatasetSplit {
  UNSPECIFIED
  TRAIN
  EVAL
  HOLDOUT
}

enum V2RecordStatus {
  ACTIVE
  DISABLED
  ARCHIVED
}

enum V2ProjectStage {
  PLANNING
  IN_PROGRESS
  PAUSED
  COMPLETED
}

enum V2MembershipRole {
  OWNER
  ADMIN
  MANAGER
  TEAM_LEAD
  SDR
  VIEWER
}

enum V2MembershipStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum V2ICPVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum V2ContactIdentifierType {
  EMAIL
  PHONE
  LINKEDIN
  OTHER
}

enum V2ContactIdentifierValidityStatus {
  VALID
  INVALID
  BOUNCED
  SUPPRESSED
  UNKNOWN
  NOT_FOUND
  PRIVATE
}

enum V2Qualification {
  QUALIFIED
  NEEDS_REVIEW
  UNQUALIFIED
  COMPANY_QUALIFIED_NEEDS_CONTACT
  UNCERTAIN
}

enum V2AccountPreRank {
  STRONG_ACCOUNT_FIT
  POSSIBLE_ACCOUNT_FIT
  WEAK_FIT
  CLEAR_MISMATCH
}

enum V2ResearchStatus {
  SUCCESS
  NO_WEBSITE
  OFFLINE
  BLOCKED
  TIMEOUT
  JS_RENDER_REQUIRED
  PARTIAL
  INVALID_URL
  PARKED
  NOT_RUN
}

enum V2CompanyIntelligenceProfileStatus {
  PLACEHOLDER
  EXTRACTED
  PARTIAL
  FAILED
}

enum V2DatasetSplit {
  UNSPECIFIED
  TRAIN
  EVAL
  HOLDOUT
}

enum V2IngestionJobType {
  COMPANY_UPLOAD
  CONTACT_UPLOAD
  ACTIVITY_RECAP
}

enum V2IngestionJobStatus {
  PENDING
  VALIDATING
  VALIDATED_WITH_ERRORS
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
  ABANDONED
}

enum V2IngestionRowStatus {
  RAW
  NORMALIZED
  MATCHED
  APPLIED
  ERROR
}

enum V2LeadAssignmentLevel {
  COMPANY
  CONTACT
}

enum V2LeadWorkflowStatus {
  NEW
  ASSIGNED
  WORKING
  CONTACTED
  RESPONDED
  MEETING_BOOKED
  MEETING_DONE
  NURTURE
  PAUSED
  NOT_INTERESTED
  BOUNCED
  SUPPRESSED
  DISQUALIFIED
  ARCHIVED
}

enum V2TaskStatus {
  OPEN
  DONE
  CANCELLED
}

enum V2ManagerReviewStatus {
  OPEN
  IN_PROGRESS
  SNOOZED
  RESOLVED
  DISMISSED
  ARCHIVED
}

enum V2ManagerReviewPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum V2ManagerReviewConfidence {
  HIGH
  MEDIUM
  LOW
  UNKNOWN
}

enum V2ManagerReviewSourceType {
  HARD_RULE_ASSESSMENT
  MANUAL_SDR_REQUEST
  WORKFLOW_CONFLICT
  INGESTION_ROW
  IDENTITY_MATCH
  ACTIVITY_RECAP_ROW
  AI_SUGGESTION
  FEEDBACK_EXAMPLE
}

enum V2ManagerReviewReasonCode {
  SCORING_NEEDS_REVIEW
  MISSING_REQUIRED_EVIDENCE
  LOW_CONFIDENCE_HARD_DISQUALIFIER
  WEAK_COMPANY_ONLY_EVIDENCE
  SDR_REQUESTED_REVIEW
  WORKFLOW_STATUS_CONFLICT
  NO_MATCH_FROM_RECAP
  MULTIPLE_COMPANY_CANDIDATES
  MULTIPLE_CONTACT_CANDIDATES
  GENERIC_EMAIL_ONLY
  FUZZY_NAME_ONLY
  NO_PROJECT_CONTEXT
  POSSIBLE_DUPLICATE_ACTIVITY
  STATUS_CHANGE_SUGGESTED
  STALE_ACTIVITY_DATE
  COMPANY_DOMAIN_CONFLICT
  AI_DISAGREEMENT
}

enum V2ManagerReviewResolutionType {
  APPROVE_CONFIRM
  REJECT_DISMISS
  REQUEST_CHANGES
  LINK_EXISTING
  CREATE_MISSING_ENTITY_LATER
  NO_ACTION_NON_ACTIONABLE
  CONVERT_TO_FEEDBACK_LATER
  UPDATE_WORKFLOW_STATUS_LATER
}

enum V2JobType {
  INGESTION_PARSE
  INGESTION_NORMALIZE
  IDENTITY_MATCH
  LEAD_ASSIGNMENT_UPSERT
  COMPANY_ENRICHMENT
  ICP_SCORE
  ACTIVITY_APPLY
  EXPORT_GENERATE
  AI_INSIGHT_GENERATE
  RESEARCH_DISCOVERY
  RESEARCH_ENRICH
  EMAIL_SEND
  SEQUENCE_STEP_EXECUTE
}

enum V2JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  RETRY_SCHEDULED
}

enum V2JobSourceType {
  INGESTION_JOB
  INGESTION_ROW
  LEAD_ASSIGNMENT
  HARD_RULE_ASSESSMENT
  AI_INSIGHT
  EXPORT_JOB
  EMAIL_SEND
  SEQUENCE_ENROLLMENT
  MANUAL
}

enum V2SuppressionScopeType {
  ORGANIZATION
  PROJECT
  COMPANY
  CONTACT
  LEAD_ASSIGNMENT
  GLOBAL
}

enum V2SuppressionIdentifierType {
  EMAIL
  DOMAIN
  PHONE
  LINKEDIN
  CONTACT_ID
  COMPANY_ID
}

enum V2SuppressionType {
  UNSUBSCRIBE
  BOUNCE
  BLACKLIST
  MANUAL
  TENANT_LEVEL
  GLOBAL
}

model V2Organization {
  id        String         @id @default(cuid())
  name      String
  slug      String         @unique
  status    V2RecordStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  teams                       V2Team[]
  memberships                 V2OrganizationMembership[]
  auditEvents                 V2AuditEvent[]
  clientAccounts              V2ClientAccount[]
  projects                    V2Project[]
  projectMemberships          V2ProjectTeamMember[]
  offers                      V2Offer[]
  icpProfiles                 V2ICPProfile[]
  icpVersions                 V2ICPVersion[]
  companies                   V2Company[]
  contacts                    V2Contact[]
  contactIdentifiers          V2ContactIdentifier[]
  leadAssignments             V2LeadAssignment[]
  hardRuleAssessments         V2HardRuleAssessment[]
  managerReviewItems          V2ManagerReviewItem[]          @relation("V2ManagerReviewItemOrganization")
  aiInsights                  V2AiInsight[]
  feedbackExamples            V2FeedbackExample[]
  ingestionJobs               V2IngestionJob[]
  ingestionRows               V2IngestionRow[]
  jobs                        V2Job[]
  suppressionEntries          V2SuppressionEntry[]
  companyResearchSnapshots    V2CompanyResearchSnapshot[]
  companyIntelligenceProfiles V2CompanyIntelligenceProfile[]
  v2ResearchRuns              V2ResearchRun[]
  v2ResearchCandidates        V2ResearchCandidate[]
  v2ResearchProspects         V2ResearchProspect[]
  v2ResearchEvidence          V2ResearchEvidence[]
  v2ResearchFieldObservations V2ResearchFieldObservation[]
  v2ResearchProviderAttempts  V2ResearchProviderAttempt[]
  v2ResearchEmailPatterns     V2ResearchEmailPattern[]

  @@index([status])
  @@index([createdAt])
}

model V2User {
  id              String         @id @default(cuid())
  email           String
  emailNormalized String         @unique
  name            String?
  status          V2RecordStatus @default(ACTIVE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  memberships                V2OrganizationMembership[]
  credential                 V2UserCredential?
  authSessions               V2AuthSession[]
  auditEvents                V2AuditEvent[]
  publishedICPVersions       V2ICPVersion[]             @relation("V2ICPVersionPublishedBy")
  generatedAiInsights        V2AiInsight[]              @relation("V2AiInsightGeneratedBy")
  reviewedFeedbackExamples   V2FeedbackExample[]        @relation("V2FeedbackExampleReviewedBy")
  uploadedIngestionJobs      V2IngestionJob[]           @relation("V2IngestionJobUploadedBy")
  createdJobs                V2Job[]                    @relation("V2JobCreatedBy")
  createdSuppressionEntries  V2SuppressionEntry[]       @relation("V2SuppressionEntryCreatedBy")
  deletedCompanies           V2Company[]                @relation("V2CompanyDeletedBy")
  deletedContacts            V2Contact[]                @relation("V2ContactDeletedBy")
  deletedLeadAssignments     V2LeadAssignment[]         @relation("V2LeadAssignmentDeletedBy")
  deletedICPVersions         V2ICPVersion[]             @relation("V2ICPVersionDeletedBy")
  ownedClientAccounts        V2ClientAccount[]
  ownedProjects              V2Project[]                @relation("V2ProjectOwner")
  projectMemberships         V2ProjectTeamMember[]
  deletedSuppressionEntries  V2SuppressionEntry[]       @relation("V2SuppressionEntryDeletedBy")
  assignedManagerReviewItems V2ManagerReviewItem[]      @relation("V2ManagerReviewItemAssignedToUser")
  createdManagerReviewItems  V2ManagerReviewItem[]      @relation("V2ManagerReviewItemCreatedByUser")
  resolvedManagerReviewItems V2ManagerReviewItem[]      @relation("V2ManagerReviewItemResolvedByUser")

  @@index([status])
  @@index([createdAt])
}

model V2Team {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  status         V2RecordStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization V2Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships  V2OrganizationMembership[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([status])
}

model V2OrganizationMembership {
  id             String             @id @default(cuid())
  organizationId String
  userId         String
  teamId         String?
  role           V2MembershipRole
  status         V2MembershipStatus @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization V2Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         V2User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  team         V2Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([teamId])
  @@index([role])
  @@index([status])
}

model V2UserCredential {
  id                String    @id @default(cuid())
  userId            String    @unique
  passwordHash      String
  passwordUpdatedAt DateTime  @default(now())
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user V2User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lockedUntil])
  @@index([updatedAt])
}

model V2AuthSession {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique
  expiresAt     DateTime
  revokedAt     DateTime?
  lastSeenAt    DateTime?
  userAgentHash String?
  ipHash        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user V2User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([lastSeenAt])
}

model V2AuditEvent {
  id             String   @id @default(cuid())
  organizationId String?
  actorUserId    String?
  eventType      String
  entityType     String?
  entityId       String?
  metadataJson   Json?
  createdAt      DateTime @default(now())

  organization V2Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorUser    V2User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([eventType])
  @@index([createdAt])
}

model V2ClientAccount {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  description    String?
  ownerUserId    String?
  region         String?
  industry       String?
  status         V2RecordStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization V2Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ownerUser    V2User?        @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  projects     V2Project[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([ownerUserId])
  @@index([status])
  @@index([createdAt])
}

model V2Project {
  id              String         @id @default(cuid())
  organizationId  String
  clientAccountId String
  name            String
  description     String?
  status          V2RecordStatus @default(ACTIVE)
  ownerUserId     String?
  stage           V2ProjectStage @default(PLANNING)
  startDate       DateTime?
  endDate         DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization       V2Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  clientAccount      V2ClientAccount       @relation(fields: [clientAccountId], references: [id], onDelete: Restrict)
  ownerUser          V2User?               @relation("V2ProjectOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  teamMembers        V2ProjectTeamMember[]
  offers             V2Offer[]
  leadAssignments    V2LeadAssignment[]
  ingestionJobs      V2IngestionJob[]
  managerReviewItems V2ManagerReviewItem[] @relation("V2ManagerReviewItemProject")

  @@unique([organizationId, clientAccountId, name])
  @@index([organizationId])
  @@index([clientAccountId])
  @@index([status])
  @@index([createdAt])
}

model V2ProjectTeamMember {
  projectId      String
  userId         String
  organizationId String
  createdAt      DateTime @default(now())

  project      V2Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         V2User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization V2Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([projectId, userId])
  @@index([organizationId])
  @@index([createdAt])
}

model V2Offer {
  id             String         @id @default(cuid())
  organizationId String
  projectId      String
  name           String
  description    String?
  status         V2RecordStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization V2Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      V2Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  icpProfiles  V2ICPProfile[]

  @@unique([organizationId, projectId, name])
  @@index([organizationId])
  @@index([projectId])
  @@index([status])
  @@index([createdAt])
}

model V2ICPProfile {
  id             String         @id @default(cuid())
  organizationId String
  offerId        String
  name           String
  description    String?
  status         V2RecordStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization V2Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  offer        V2Offer        @relation(fields: [offerId], references: [id], onDelete: Restrict)
  versions     V2ICPVersion[]

  @@unique([organizationId, offerId, name])
  @@index([organizationId])
  @@index([offerId])
  @@index([status])
  @@index([createdAt])
}

model V2ICPVersion {
  id                String             @id @default(cuid())
  organizationId    String
  icpProfileId      String
  versionNumber     Int
  status            V2ICPVersionStatus @default(DRAFT)
  rulesJson         Json?
  publishedAt       DateTime?
  publishedByUserId String?
  version           Int                @default(1)
  deletedAt         DateTime?
  deletedByUserId   String?
  deletionReason    String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  organization        V2Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  icpProfile          V2ICPProfile           @relation(fields: [icpProfileId], references: [id], onDelete: Restrict)
  publishedByUser     V2User?                @relation("V2ICPVersionPublishedBy", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  deletedByUser       V2User?                @relation("V2ICPVersionDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  leadAssignments     V2LeadAssignment[]
  hardRuleAssessments V2HardRuleAssessment[]
  managerReviewItems  V2ManagerReviewItem[]  @relation("V2ManagerReviewItemIcpVersion")
  aiInsights          V2AiInsight[]
  feedbackExamples    V2FeedbackExample[]

  @@unique([organizationId, icpProfileId, versionNumber])
  @@index([organizationId])
  @@index([icpProfileId])
  @@index([status])
  @@index([organizationId, status, version])
  @@index([publishedAt])
  @@index([publishedByUserId])
  @@index([deletedAt])
  @@index([deletedByUserId])
  @@index([createdAt])
}

model V2Company {
  id               String         @id @default(cuid())
  organizationId   String
  name             String
  nameNormalized   String
  canonicalDomain  String?
  websiteUrl       String?
  linkedinUrl      String?
  country          String?
  // Raw industry as supplied by the upload/LinkedIn (e.g. "Food & Beverages"). Feeds the scoring
  // industry dimension + the classification weak-prior. Distinct from the derived industryCategory.
  industry         String?
  employeeCountRange String? // e.g. "5,001 - 10,000 employees" — parsed to a size band at scoring.
  revenue          String?
  // Denormalized industry category id (e.g. "logistics", "b2b_saas") derived from the
  // latest company-intelligence reasoning taxonomy. Lets the directory aggregate
  // "top industries" + filter by industry without scanning factsJson. Descriptive
  // only â€” NOT an ICP qualification (Invariant 2). Written by the enrichment handler.
  industryCategory String?
  status           V2RecordStatus @default(ACTIVE)
  deletedAt        DateTime?
  deletedByUserId  String?
  deletionReason   String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization         V2Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deletedByUser        V2User?                        @relation("V2CompanyDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  leadAssignments      V2LeadAssignment[]
  managerReviewItems   V2ManagerReviewItem[]          @relation("V2ManagerReviewItemCompany")
  matchedIngestionRows V2IngestionRow[]               @relation("V2IngestionRowMatchedCompany")
  researchSnapshots    V2CompanyResearchSnapshot[]
  intelligenceProfiles V2CompanyIntelligenceProfile[]

  @@unique([organizationId, canonicalDomain])
  @@index([organizationId])
  @@index([nameNormalized])
  @@index([status])
  @@index([deletedAt])
  @@index([organizationId, industryCategory])
  @@index([deletedByUserId])
  @@index([createdAt])
}

model V2CompanyResearchSnapshot {
  id                String           @id @default(cuid())
  organizationId    String
  companyId         String
  canonicalDomain   String?
  websiteUrl        String?
  status            V2ResearchStatus
  httpStatus        Int?
  finalUrl          String?
  redirectChainJson Json?
  pagesFetchedJson  Json?
  searchResultsJson Json?
  rawTextHash       String?
  contentHash       String?
  errorCode         String?
  errorMessage      String?
  researchVersion   Int              @default(1)
  idempotencyKey    String           @unique
  createdAt         DateTime         @default(now())

  organization         V2Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company              V2Company                      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  intelligenceProfiles V2CompanyIntelligenceProfile[] @relation("V2CompanyIntelligenceProfileSourceSnapshot")

  @@index([organizationId, companyId, createdAt])
  @@index([canonicalDomain])
  @@index([status])
  @@index([createdAt])
}

model V2CompanyIntelligenceProfile {
  id                       String                             @id @default(cuid())
  organizationId           String
  companyId                String
  canonicalDomain          String?
  sourceResearchSnapshotId String?
  companySummary           String?
  factsJson                Json?
  evidenceItemsJson        Json?
  classificationJson       Json?
  sourceCoverageJson       Json?
  riskSignalsJson          Json?
  confidenceJson           Json?
  profileStatus            V2CompanyIntelligenceProfileStatus
  staleAt                  DateTime?
  researchVersion          Int                                @default(1)
  idempotencyKey           String                             @unique
  createdAt                DateTime                           @default(now())

  organization           V2Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company                V2Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sourceResearchSnapshot V2CompanyResearchSnapshot? @relation("V2CompanyIntelligenceProfileSourceSnapshot", fields: [sourceResearchSnapshotId], references: [id], onDelete: SetNull)

  @@unique([organizationId, companyId, researchVersion])
  @@index([organizationId, companyId, createdAt])
  @@index([canonicalDomain])
  @@index([profileStatus])
  @@index([staleAt])
  @@index([createdAt])
}

model V2Contact {
  id                 String         @id @default(cuid())
  organizationId     String
  fullName           String
  fullNameNormalized String?
  firstName          String?
  lastName           String?
  title              String?
  city               String? // Contacts & Leads people layer: contact location (drawer header)
  country            String?
  department         String? // Uploaded descriptive fields (filter facets). Not scoring inputs —
  seniority          String? // personaScore still derives seniority from the title string.
  status             V2RecordStatus @default(ACTIVE)
  deletedAt          DateTime?
  deletedByUserId    String?
  deletionReason     String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization         V2Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deletedByUser        V2User?               @relation("V2ContactDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  identifiers          V2ContactIdentifier[]
  leadAssignments      V2LeadAssignment[]
  managerReviewItems   V2ManagerReviewItem[] @relation("V2ManagerReviewItemContact")
  matchedIngestionRows V2IngestionRow[]      @relation("V2IngestionRowMatchedContact")

  @@index([organizationId])
  @@index([fullNameNormalized])
  @@index([status])
  @@index([deletedAt])
  @@index([deletedByUserId])
  @@index([createdAt])
}

model V2ContactIdentifier {
  id              String                            @id @default(cuid())
  organizationId  String
  contactId       String
  type            V2ContactIdentifierType
  normalizedValue String
  rawValue        String?
  isGeneric       Boolean                           @default(false)
  isValid         Boolean                           @default(true)
  validityStatus  V2ContactIdentifierValidityStatus @default(UNKNOWN)
  source          String?
  lastValidatedAt DateTime?
  createdAt       DateTime                          @default(now())
  updatedAt       DateTime                          @updatedAt

  organization V2Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contact      V2Contact      @relation(fields: [contactId], references: [id], onDelete: Restrict)

  // One identifier value per (contact, type) per org — makes the ingestion/research upsert idempotent
  // at the DB level (Inv 6), replacing the app-level SELECT-then-insert that could race into dupes.
  @@unique([organizationId, type, normalizedValue, contactId])
  @@index([organizationId])
  @@index([contactId])
  @@index([type, normalizedValue])
  @@index([validityStatus])
  @@index([isGeneric])
  @@index([createdAt])
}

// Employment history for a contact (person-centric). A contact can have many
// employments; isCurrent marks the present employer. This models a job change
// (same V2Contact, new company employment) instead of duplicating the person.
// Soft FKs (app-enforced integrity), matching the V2 child-table convention.
model V2ContactEmployment {
  id             String    @id @default(cuid())
  organizationId String
  contactId      String
  companyId      String
  title          String?
  isCurrent      Boolean   @default(true)
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, contactId])
  @@index([organizationId, companyId])
  @@index([contactId, isCurrent])
}

model V2LeadAssignment {
  id                         String                @id @default(cuid())
  organizationId             String
  companyId                  String
  contactId                  String?
  projectId                  String
  icpVersionId               String
  assignmentLevel            V2LeadAssignmentLevel @default(COMPANY)
  workflowStatus             V2LeadWorkflowStatus  @default(NEW)
  latestHardRuleAssessmentId String?
  // M1 lead ownership: the SDR who owns/works this lead. Soft FK to V2User
  // (app-validated as an active org member), distinct from workflowStatus and
  // qualification (Invariant 3 â€” ownership is not workflow, not qualification).
  ownerUserId                String?
  assignedAt                 DateTime?
  assignedByUserId           String?
  status                     V2RecordStatus        @default(ACTIVE)
