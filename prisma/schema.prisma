  @@index([organizationId, category], map: "V2MessageTemplate_org_category_idx")
  @@index([organizationId, updatedAt], map: "V2MessageTemplate_org_updated_idx")
}

// LeadAssignment-scoped recipient and merge profile. Never a Company-global score.
