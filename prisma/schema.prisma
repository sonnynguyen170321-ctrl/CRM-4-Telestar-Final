// Idempotent per (org, date, provider, model). Drives the usage chart + budget gate.
model V2AiUsageDaily {
  id             String           @id @default(cuid())
  organizationId String
  usageDate      DateTime         @db.Date
  provider       V2AiProviderKind
  modelId        String
  requests       Int              @default(0)
