# Copy this file to .env.docker for local Docker, or .env.production on the VPS.
# For VPS usage set APP_ENV_FILE=.env.production inside .env.production.
APP_ENV_FILE=.env.docker
IMAGE_TAG=latest

# Public hostname served by Caddy. Local uses HTTPS; AWS IP mode uses :80.
CRM_DOMAIN=localhost
CADDY_SITE_ADDRESS=localhost
NEXTAUTH_URL=https://localhost

# Local all-in-one Postgres container credentials.
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me-generate-a-long-random-password
POSTGRES_DB=telestar_crm

# Internal service URLs used by the web and worker containers.
DATABASE_URL=postgresql://crm:${POSTGRES_PASSWORD}@postgres:5432/telestar_crm
DIRECT_URL=postgresql://crm:${POSTGRES_PASSWORD}@postgres:5432/telestar_crm
BACKUP_DATABASE_URL=postgresql://crm:${POSTGRES_PASSWORD}@postgres:5432/telestar_crm
REDIS_URL=redis://redis:6379

# Required production secrets. Generate fresh values before using a real VPS:
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   openssl rand -hex 32
AUTH_SECRET=replace-with-base64-auth-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CRON_SECRET=replace-with-hex-cron-secret

# Keep unattended sends disabled until the worker path is smoke-tested.
SEQUENCE_AUTOSEND_ENABLED=false
EMAIL_SEND_DRY_RUN=true

# First production admin. Prefer overriding these in the VPS env file.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-password
ADMIN_NAME=CRM Admin

# Optional integrations.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://localhost/api/email/oauth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://localhost/api/email/oauth/microsoft/callback
GROQ_API_KEY=
GEMINI_API_KEY=

# Cloudflare R2 backup target used by scripts/backup-postgres-r2.sh.
R2_REMOTE=r2
R2_BUCKET=replace-with-r2-bucket
R2_PREFIX=crm-4-u/postgres

# AWS IP mode example:
# CRM_DOMAIN=46.137.208.100
# CADDY_SITE_ADDRESS=:80
# NEXTAUTH_URL=http://46.137.208.100
#
# AWS domain mode example:
# CRM_DOMAIN=crm.example.com
# CADDY_SITE_ADDRESS=crm.example.com
# NEXTAUTH_URL=https://crm.example.com
