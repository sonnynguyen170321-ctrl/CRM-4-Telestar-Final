# /opt/crm/.env.production on the Hostinger VPS — copy, fill, chmod 600. Never commit the filled file.
# Validate with: npm run prod:check-env   (reads .env.production)
#
# Same file shape as .env.production.example; the lines that differ for this host are marked ##.

## Target + compose profile ─────────────────────────────────────────────────────────────────
DEPLOY_TARGET=hostinger
# Exactly one of:  cloudsql  (Phase 6a — DB still on Cloud SQL through the proxy sidecar)
#                  localdb   (Phase 6b — DB on this VPS in the crm-db service)
COMPOSE_PROFILES=cloudsql
COMPOSE_PROJECT_NAME=crm
APP_ENV_FILE=.env.production

## Routing — Traefik on the host routes Host(`CRM_DOMAIN`) to web:3000 and issues the cert ────
CRM_DOMAIN=crm.telestar.cloud
NEXTAUTH_URL=https://crm.telestar.cloud
# CADDY_SITE_ADDRESS must stay UNSET here: the caddy service is disabled on this target.

## Image — written by scripts/deploy.sh; never edit by hand, never use :latest ─────────────
CRM_IMAGE=ghcr.io/sonnynguyen170321-ctrl/crm-4-telestar-final@sha256:REPLACE_ON_FIRST_DEPLOY
PREVIOUS_CRM_IMAGE=

## Database ───────────────────────────────────────────────────────────────────────────────
# Phase 6a (COMPOSE_PROFILES=cloudsql): host MUST be cloudsql-proxy
DATABASE_URL=postgresql://crm:REPLACE@cloudsql-proxy:5432/telestar_crm
DIRECT_URL=postgresql://crm:REPLACE@cloudsql-proxy:5432/telestar_crm
BACKUP_DATABASE_URL=postgresql://crm:REPLACE@cloudsql-proxy:5432/telestar_crm
CLOUDSQL_INSTANCE=telestar-crm-final:asia-southeast1:telestar-db
CLOUDSQL_SA_FILE=/opt/crm/secrets/cloudsql-sa.json
# Phase 6b (COMPOSE_PROFILES=localdb): host MUST be crm-db, and POSTGRES_PASSWORD is required
# DATABASE_URL=postgresql://crm:REPLACE@crm-db:5432/telestar_crm
# DIRECT_URL=postgresql://crm:REPLACE@crm-db:5432/telestar_crm
# BACKUP_DATABASE_URL=postgresql://crm:REPLACE@crm-db:5432/telestar_crm
# POSTGRES_USER=crm
# POSTGRES_PASSWORD=REPLACE
# POSTGRES_DB=telestar_crm

## Redis — the overlay's own instance (noeviction, AOF). Not Nextcloud's. ─────────────────
REDIS_URL=redis://redis:6379

## Secrets — generate with `openssl rand -hex 32`; copy the CURRENT production values for a
## cutover (scp from the GCP VM), fresh ones for staging ───────────────────────────────────
AUTH_SECRET=REPLACE_64_HEX
ENCRYPTION_KEY=REPLACE_64_HEX
CRON_SECRET=REPLACE_64_HEX

## Email safety — staging keeps BOTH of these; production flips them at Phase 6a step 3 ────
EMAIL_SEND_DRY_RUN=true
SEQUENCE_AUTOSEND_ENABLED=false
EMAIL_GLOBAL_PAUSE=false
EMAIL_HEALTH_AUTOPAUSE=true
LIVE_EMAIL_CANARY_MODE=false
LIVE_EMAIL_ALLOWED_RECIPIENTS=

## AI providers — all three are required (prod:check-env enforces failover) ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

## Backups ───────────────────────────────────────────────────────────────────────────────────
# Two layers, and the fine one is not optional. pgBackRest streams WAL continuously so recovery
# lands on a point in time (deploy/hostinger/pgbackrest/README.md); backup.sh takes the coarse
# logical dump that can rebuild the database somewhere else. A nightly dump alone means losing up
# to a day of every tenant's replies and sequence state.
CRM_BACKUP_DIR=/opt/crm/backups
BACKUP_KEEP=14
# age PUBLIC key. The dump carries every tenant's prospect data and the ciphertext of customer
# mailbox tokens, so it is encrypted before it leaves the host. Keep the matching PRIVATE key off
# this machine — a VPS that can decrypt its own backup history protects nothing once compromised.
# Generate:  age-keygen -o crm-backup.key   (the public line goes here, the file goes in a vault)
BACKUP_AGE_RECIPIENT=age1REPLACE
# Only set on a machine that is doing a restore, pointing at the private key file. Never on the VPS.
# BACKUP_AGE_IDENTITY=/path/to/crm-backup.key
# rclone remote for --offsite. REQUIRED on this target — the VPS has no platform snapshot
# (Hostinger's location change deletes them and none are purchased), so the off-host copy is the
# only backup that exists. Run `rclone config` for the remote before the first deploy.
BACKUP_REMOTE=gcs:telestar-crm-backups
