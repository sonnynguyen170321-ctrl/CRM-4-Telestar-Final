# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ad-hoc debug / scratch probes (root only) — never commit; use lib/__tests__ + scripts/
/debug-*.ts
/debug-*.js
/debug-*.mjs
/check.ts
/check[0-9]*.ts
/reset-*.ts
/run-jobs.ts
/*.scratch.ts

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# Audit / maintenance script output. Regenerated on every run, never a source of truth.
/*.report.json
