DATABASE_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
APP_URL=http://localhost:3000

# V2 self-hosted auth. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
V2_AUTH_SECRET=
V2_AUTH_COOKIE_NAME=v2_session
V2_AUTH_SESSION_DAYS=14

AI_ENABLED=false
AI_PROVIDER=gemini
AI_MODE=queue
AI_TIMEOUT_MS=15000
AI_MAX_OUTPUT_TOKENS=450
AI_MAX_ROWS_PER_UPLOAD=200
AI_SCORING_MODE=all_companies
AI_CONCURRENCY=1
AI_REQUEST_DELAY_MS=8000
AI_MAX_RETRIES=5
AI_BACKOFF_BASE_SECONDS=60
AI_BACKOFF_MAX_SECONDS=1800
AI_DAILY_REQUEST_BUDGET=200
AI_RPM_SOFT_LIMIT=6
AI_TPM_SOFT_LIMIT=50000
AI_MAX_INPUT_CHARS=2500
AI_MAX_WEBSITE_SIGNAL_CHARS=1200
AI_MAX_REASON_CHARS=300
AI_CACHE_ENABLED=true
AI_JOB_PROCESS_SECRET=
AI_ADMIN_PROCESS_UI_ENABLED=false
AI_WORKER_APP_URL=http://localhost:3000
AI_WORKER_POLL_MS=9000

# V2 company-intelligence web search (rich insight depth).
# Off by default: when unset, enrichment uses website-only deterministic facts.
# Set a provider + key to enable third-party search (news/funding/expansion).
V2_SEARCH_PROVIDER=
# one of: brave | serpapi | bing
V2_SEARCH_API_KEY=
V2_SEARCH_ENDPOINT=
V2_SEARCH_MAX_RESULTS=3
V2_SEARCH_TIMEOUT_MS=6000

# CINT company-intel reasoning search (provider chain Exa -> Brave -> Serper).
# Server-only. Keys never logged, never exposed to client. Leave keys blank to keep
# the chain disabled; default checks/tests run mock-only (no live API quota burned).
COMPANY_INTEL_SEARCH_ENABLED=false
# Chain order; each active only when configured (key / SEARXNG_URL / DDG_SEARCH_ENABLED).
COMPANY_INTEL_SEARCH_PROVIDER_CHAIN=exa,brave,serper,searxng,ddg
EXA_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
# OSS providers (free, no paid key):
#   SearXNG — self-hosted metasearch; set to your instance base URL (must enable formats: [json]).
SEARXNG_URL=
#   DuckDuckGo — keyless HTML endpoint; unofficial + rate-limited. Enable explicitly.
DDG_SEARCH_ENABLED=false
# Optional local neural rerank (approximate Exa relevance). Needs `npm i @huggingface/transformers`.
SEARCH_RERANK_ENABLED=false
# SEARCH_RERANK_MODEL=Xenova/all-MiniLM-L6-v2
COMPANY_INTEL_SEARCH_TIMEOUT_MS=8000
COMPANY_INTEL_SEARCH_RESULTS_PER_QUERY=5
COMPANY_INTEL_SEARCH_MIN_USABLE_RESULTS=2
COMPANY_INTEL_SEARCH_MAX_QUERIES_PER_COMPANY=2
# Up to 6 so a full chain (3 paid + searxng + ddg) is reachable per query.
COMPANY_INTEL_SEARCH_MAX_PROVIDER_ATTEMPTS_PER_QUERY=6
# Process-wide cap on concurrent SERP calls — keeps high enrichment concurrency from
# rate-limiting the search providers. Overflow waits for a slot.
COMPANY_INTEL_SEARCH_MAX_CONCURRENCY=8

# Ingestion enrichment throughput (network-bound; AI off => rules-only, safe to parallelize).
# Concurrency of the enrich/score BullMQ stages (companies processed at once):
V2_BULL_INGEST_ENRICH_CONCURRENCY=12
V2_BULL_INGEST_SCORE_CONCURRENCY=8
# Postgres pool max PER PROCESS. Keep V2_DB_POOL_MAX * process_count < DB max_connections.
V2_DB_POOL_MAX=24
# Priority pages crawled per company (of 14). Fewer = faster per company. Homepage always first.
COMPANY_INTEL_MAX_CRAWL_PAGES=6
# Domain-dedup crawl cache TTL (ms). Repeated domains in a batch skip the crawl. 0 disables.
COMPANY_INTEL_DOMAIN_CACHE_TTL_MS=600000

# V2 outreach (O-pillar). Master key for AES-256-GCM sender-credential encryption
# (B1). 32 bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Absent ⇒ credential loader fails closed (no send). Never commit a real value.
V2_OUTREACH_CREDENTIAL_KEY=
# O5s background worker: shared secret gating POST /v2/outreach/drain, app URL, interval.
# In AWS, set V2_WORKER_APP_URL to the HTTPS web-app URL or an internal service URL.
V2_WORKER_SECRET=
V2_WORKER_APP_URL=http://localhost:3000
V2_WORKER_INTERVAL_MS=15000
# OL3 inbound poller: run npm run v2:imap alongside npm run v2:worker for replies/bounces.
V2_IMAP_POLL_INTERVAL_MS=60000
# Custom tracking-domain host/secret. V2_TRACKING_HOST is the CNAME target for tracking subdomains.
# Keep blank to hide open/click metrics instead of faking them.
V2_TRACKING_HOST=
V2_TRACKING_SECRET=

# BullMQ runtime (Redis). When V2_BULL_ENABLED is truthy the ingestion pipeline + scoring
# + research run on Redis-backed queues (instant stage pickup, fast drawer). When unset/0,
# the whole BullMQ layer stays inert and jobs drain via the DB worker (no Redis needed).
V2_BULL_ENABLED=
REDIS_URL=
V2_BULL_PREFIX=telestar:v2
V2_BULL_WORKER_ID=
# Per-stage ingestion worker concurrency (how many distinct jobs advance per stage).
V2_BULL_INGEST_PARSE_CONCURRENCY=3
V2_BULL_INGEST_NORMALIZE_CONCURRENCY=3
V2_BULL_INGEST_IDENTITY_CONCURRENCY=3
V2_BULL_INGEST_LEAD_UPSERT_CONCURRENCY=3
V2_BULL_INGEST_ACTIVITY_CONCURRENCY=3
V2_BULL_INGEST_ACTIVITY_APPLY_CONCURRENCY=3
V2_BULL_INGEST_ENRICH_CONCURRENCY=3
V2_BULL_INGEST_SCORE_CONCURRENCY=3
# O9 live-send kill switch: 1/true/on halts ALL live sends immediately.
V2_OUTREACH_KILL_SWITCH=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

OPENAI_API_KEY=
OPENAI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
