# Copy this file to .env.production on the server and fill in real values there.
# Do not commit real secrets or database credentials.
#
# This is the PRODUCTION env template. The authoritative full list of knobs lives in
# .env.example; only the deploy-critical ones are shown here with AWS guidance.
# See docs/aws-migration-runbook.md (ECS) or deploy/aws-ec2/README.md (EC2 + compose).

NODE_ENV=production

# --- Database (RDS PostgreSQL) -------------------------------------------------
# AWS RDS: postgresql://USER:PASSWORD@RDS-ENDPOINT:5432/DATABASE?schema=public
DATABASE_URL=postgresql://USER:PASSWORD@RDS-ENDPOINT:5432/telestar?schema=public
# Postgres pool max PER PROCESS. Keep V2_DB_POOL_MAX * process_count < RDS max_connections.
V2_DB_POOL_MAX=24

# --- Public base URL -----------------------------------------------------------
# The externally reachable HTTPS origin. On EC2 + Caddy + sslip.io this is
# https://<eip-with-dashes>.sslip.io. NEXT_PUBLIC_APP_URL is inlined into the image at
# BUILD time (Dockerfile ARG) — build with the final value; the others are runtime.
NEXT_PUBLIC_APP_URL=https://your-app.example.com
APP_BASE_URL=https://your-app.example.com
APP_URL=https://your-app.example.com

# --- Self-hosted V2 auth (replaces the removed Auth0 integration) --------------
# Session signing secret. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
V2_AUTH_SECRET=
V2_AUTH_COOKIE_NAME=v2_session
V2_AUTH_SESSION_DAYS=14

# --- BullMQ runtime queues (ElastiCache Redis) ---------------------------------
# When truthy, ingestion + scoring + research + durable outreach jobs run on Redis-backed
# queues (real processors — see lib/v2/bullmq/events.ts). Unset ⇒ DB-drain fallback.
V2_BULL_ENABLED=true
REDIS_URL=redis://ELASTICACHE-PRIMARY-ENDPOINT:6379
V2_BULL_PREFIX=telestar:v2
# Set per worker container (optional); leave blank to auto-derive from pid.
V2_BULL_WORKER_ID=

# --- Runtime worker (v2:worker) + ops health ----------------------------------
# Shared secret gating POST /v2/outreach/drain and GET /v2/runtime/health.
V2_WORKER_SECRET=
# Base URL the worker calls back on. On one EC2 host use the internal compose DNS.
V2_WORKER_APP_URL=http://web:3000
V2_WORKER_INTERVAL_MS=15000

# --- Outreach (O-pillar) -------------------------------------------------------
# Master key for AES-256-GCM sender-credential encryption. 32 bytes, base64. Absent ⇒
# credential loader fails closed (no send). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
V2_OUTREACH_CREDENTIAL_KEY=
# Global live-send kill switch: 1/true/on halts ALL sends immediately.
V2_OUTREACH_KILL_SWITCH=
# Inbound IMAP poller cadence (v2:imap service only).
V2_IMAP_POLL_INTERVAL_MS=60000
# Custom open/click tracking domain host + signing secret. Blank ⇒ metrics hidden (not faked).
V2_TRACKING_HOST=
V2_TRACKING_SECRET=

# --- AI (optional, OFF by default) --------------------------------------------
# Deterministic scoring/enrichment run with NO key. Only set these to enable advisory AI.
AI_ENABLED=false
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Company-intelligence search (optional, OFF by default) --------------------
# Enrichment uses website-only deterministic facts unless a provider chain is enabled.
COMPANY_INTEL_SEARCH_ENABLED=false
COMPANY_INTEL_SEARCH_PROVIDER_CHAIN=exa,brave,serper,searxng,ddg
EXA_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
# Self-hosted SearXNG (free) — see deploy/searxng. Must enable formats:[json].
SEARXNG_URL=
DDG_SEARCH_ENABLED=false
