{
  "family": "telestar-migrate",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT>:role/telestar-ecs-execution",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT>:role/telestar-ecs-task",
  "containerDefinitions": [
    {
      "name": "app",
      "image": "<ACCOUNT>.dkr.ecr.<REGION>.amazonaws.com/telestar-v2:latest",
      "essential": true,
      "command": ["npx", "prisma", "migrate", "deploy"],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT>:secret:telestar/DATABASE_URL" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/telestar-migrate",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "migrate",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
