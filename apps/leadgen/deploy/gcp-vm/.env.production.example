# GCP single-VM deploy — copy to `deploy/gcp-vm/.env.production` ON THE VM and fill real values.
# DO NOT COMMIT the filled file. This variant assumes Postgres + Redis run as CONTAINERS on the
# same VM (internal compose DNS), not managed RDS/ElastiCache.

NODE_ENV=production

# --- Database (postgres container on this VM) ---------------------------------
# Host `postgres` = the compose service name; creds must match docker-compose.yml.
DATABASE_URL=postgresql://telestar:telestar@postgres:5432/telestar?schema=public
V2_DB_POOL_MAX=24

# --- Public base URL ----------------------------------------------------------
# The externally reachable HTTPS origin = https://<static-ip-with-dashes>.sslip.io
# NEXT_PUBLIC_APP_URL is inlined at BUILD time via the APP_ORIGIN build arg (see README);
# APP_BASE_URL / APP_URL are read at runtime. Keep all three identical.
NEXT_PUBLIC_APP_URL=https://34-124-1-2.sslip.io
APP_BASE_URL=https://34-124-1-2.sslip.io
APP_URL=https://34-124-1-2.sslip.io

# --- Self-hosted V2 auth ------------------------------------------------------
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
V2_AUTH_SECRET=
V2_AUTH_COOKIE_NAME=v2_session
V2_AUTH_SESSION_DAYS=14

# --- BullMQ runtime queues (redis container on this VM) -----------------------
V2_BULL_ENABLED=true
REDIS_URL=redis://redis:6379
# Default {telestar:v2} cluster hash-tag is harmless on standalone redis; leave as-is.
V2_BULL_PREFIX={telestar:v2}
V2_BULL_WORKER_ID=

# --- Runtime worker + ops health ----------------------------------------------
V2_WORKER_SECRET=
V2_WORKER_APP_URL=http://web:3000
V2_WORKER_INTERVAL_MS=15000

# --- Outreach (O-pillar) ------------------------------------------------------
# AES-256-GCM master key for sender-credential encryption. 32 bytes, base64.
# !!! When migrating real data from AWS, REUSE the SAME key as the old box, or previously
# !!! encrypted sender credentials become undecryptable. Do NOT regenerate on a data migration.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
V2_OUTREACH_CREDENTIAL_KEY=
V2_OUTREACH_KILL_SWITCH=
V2_IMAP_POLL_INTERVAL_MS=60000
V2_TRACKING_HOST=
V2_TRACKING_SECRET=

# --- AI (optional, OFF by default) --------------------------------------------
AI_ENABLED=false
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Company-intelligence search (optional, OFF by default) -------------------
COMPANY_INTEL_SEARCH_ENABLED=false
COMPANY_INTEL_SEARCH_PROVIDER_CHAIN=exa,brave,serper,searxng,ddg
EXA_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
SEARXNG_URL=
DDG_SEARCH_ENABLED=false
