    "lucide-react": "^1.17.0",
    "mailparser": "^3.9.14",
    "next": "^16.2.9",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^9.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "read-excel-file": "^9.2.0",
