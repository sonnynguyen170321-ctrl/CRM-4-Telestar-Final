--- 1. protection state before (read-only) ---
$ gh api repos/sonnynguyen170321-ctrl/CRM-4-Telestar-Final/branches/main/protection
{"message":"Branch not protected","documentation_url":"https://docs.github.com/rest/branches/branch-protection#get-branch-protection","status":"404"}

--- 2. protection applied ---
$ gh api -X PUT repos/.../branches/main/protection --input prot.json
required_status_checks.strict            = true
required_status_checks.contexts          = ["CI required checks"]
enforce_admins.enabled                   = true
required_pull_request_reviews            = present, required_approving_review_count = 0
required_linear_history.enabled          = true
allow_force_pushes.enabled               = false
allow_deletions.enabled                  = false
required_conversation_resolution.enabled = true

# required_approving_review_count is 0 deliberately: this repository has a single
# maintainer, and a rule demanding a second reviewer would make it unusable
# (directive section 16). Every other control is enforced, admins included.

